---
/**
 * <Picture> — same WebP/AVIF wrap as the markdown rehype plugin, plus a
 * base64 LQIP background so the blurred placeholder paints before the
 * real image arrives.
 */
import fs from "node:fs";
import path from "node:path";

interface Props {
  src: string;
  alt: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  loading = "lazy",
  fetchpriority,
  sizes = "(min-width: 1024px) 50vw, (min-width: 720px) 70vw, 100vw",
  class: className,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, "");

let manifest: Record<string, any> = {};
try {
  const p = path.join(process.cwd(), "public", ".image-manifest.json");
  if (fs.existsSync(p)) {
    manifest = JSON.parse(fs.readFileSync(p, "utf-8"));
  }
} catch (_) {
  manifest = {};
}

let lookup = src.startsWith("/") ? src : "/" + src;
const entry = manifest[lookup];
const fullSrc = `${baseUrl}${lookup}`;

function variantSrcset(fmt: "avif" | "webp"): string | null {
  const widths = entry?.variants?.[fmt];
  if (!widths || widths.length === 0) return null;
  return widths
    .map((w: number) => `${baseUrl}${lookup.replace(/\.[^.]+$/, `-${w}.${fmt}`)} ${w}w`)
    .join(", ");
}

const avifSet = entry ? variantSrcset("avif") : null;
const webpSet = entry ? variantSrcset("webp") : null;
const pictureClass = ["lqip", className].filter(Boolean).join(" ");
const pictureStyle = entry?.lqip ? `--lqip:url('${entry.lqip}')` : undefined;
---

<picture class={pictureClass} style={pictureStyle}>
  {avifSet && <source type="image/avif" srcset={avifSet} sizes={sizes} />}
  {webpSet && <source type="image/webp" srcset={webpSet} sizes={sizes} />}
  <img
    src={fullSrc}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    width={entry?.width}
    height={entry?.height}
  />
</picture>
