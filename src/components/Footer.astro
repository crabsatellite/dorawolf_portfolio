---
import { t, type Lang } from "~/i18n/strings";
import { loadSite } from "~/i18n/loadData";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = loadSite(lang);
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="container foot__inner">
    <div class="foot__col">
      <p class="eyebrow">{site.name} · {site.fullName}</p>
      <p class="foot__role foot__role--muted">{site.location}</p>
    </div>
    <div class="foot__col">
      <p class="eyebrow">{t(lang, "footer.contact")}</p>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div class="foot__col">
      <p class="eyebrow">{t(lang, "footer.links")}</p>
      <p>
        <a
          href={`https://github.com/${site.githubRepo}`}
          rel="noopener noreferrer"
          target="_blank">{t(lang, "footer.source")}</a
        >
      </p>
    </div>
  </div>
  <div class="container foot__bottom">
    <p>
      {t(lang, "footer.rights", { year, studioName: site.studioName })}
    </p>
    <p class="foot__credit">
      {t(lang, "footer.credit", { year })}
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    margin-top: var(--space-7);
    padding: var(--space-5) 0 var(--space-3);
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .foot__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3) var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
    align-items: start;
  }
  .foot__col p {
    margin: 0.2rem 0 0;
    max-width: none;
  }
  .foot__col a {
    color: var(--fg);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition);
  }
  .foot__col a:hover {
    border-bottom-color: var(--fg);
  }
  .foot__role {
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .foot__role--muted {
    color: var(--fg-muted);
    font-size: 0.85rem;
  }
  .foot__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-2);
    font-size: 0.78rem;
    color: var(--fg-subtle);
  }
  .foot__bottom p {
    margin: 0;
  }
  .foot__credit {
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }
  @media (max-width: 540px) {
    .foot__bottom {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>
