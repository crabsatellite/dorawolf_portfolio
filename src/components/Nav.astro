---
import { t, pathForLang, type Lang } from "~/i18n/strings";
import { loadSite } from "~/i18n/loadData";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = loadSite(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

const items = [
  { href: `${langPrefix}/about`, key: "nav.about" as const },
  { href: `${langPrefix}/projects`, key: "nav.projects" as const },
  { href: `${langPrefix}/archive`, key: "nav.archive" as const },
  { href: `${langPrefix}/research`, key: "nav.research" as const },
  { href: `${langPrefix}/timeline`, key: "nav.timeline" as const },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const otherLang: Lang = lang === "en" ? "zh" : "en";
const otherLangHref = pathForLang(Astro.url.pathname, otherLang, base);
---

<header class="nav">
  <div class="nav__inner container">
    <a
      href={`${langPrefix}/`}
      class="nav__logo"
      aria-label={t(lang, "nav.home_aria", { name: site.name })}
    >
      <span class="nav__logo-name">{site.name}</span>
      <span class="nav__logo-zh" aria-hidden="true">{site.fullName}</span>
    </a>
    <nav aria-label="Primary" class="nav__primary">
      <ul class="nav__list">
        {
          items.map((item) => {
            const itemPath = item.href.replace(/\/$/, "") || "/";
            const active =
              path === itemPath || path.startsWith(itemPath + "/");
            return (
              <li>
                <a
                  href={item.href}
                  class:list={["nav__link", { "nav__link--active": active }]}
                  aria-current={active ? "page" : undefined}
                >
                  {t(lang, item.key)}
                </a>
              </li>
            );
          })
        }
        <li class="nav__lang">
          <a
            href={otherLangHref}
            class="nav__link nav__link--lang"
            aria-label={t(lang, "nav.lang_switch_aria")}
            data-lang-switch={otherLang}
          >
            {otherLang === "en" ? "EN" : "中"}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg) 86%, transparent);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-height);
    gap: 1rem;
  }
  .nav__logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--fg);
  }
  .nav__logo-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.012em;
    line-height: 1;
  }
  .nav__logo-zh {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1.1rem, 3.4vw, 2.4rem);
    align-items: center;
  }
  .nav__link {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    letter-spacing: 0.005em;
    color: var(--fg-muted);
    padding: 0.4rem 0;
    position: relative;
    transition: color var(--transition);
  }
  .nav__link:hover,
  .nav__link--active {
    color: var(--fg);
  }
  .nav__link--active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--fg);
  }
  .nav__lang {
    border-left: 1px solid var(--border);
    padding-left: clamp(0.8rem, 2vw, 1.4rem);
    margin-left: clamp(0.4rem, 1vw, 0.8rem);
  }
  .nav__link--lang {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--fg);
  }
  .nav__link--lang:hover {
    color: var(--fg-muted);
  }
  @media (max-width: 540px) {
    .nav__logo-zh {
      display: none;
    }
    .nav__list {
      gap: 0.85rem;
    }
    .nav__link {
      font-size: var(--text-sm);
    }
    .nav__lang {
      padding-left: 0.7rem;
      margin-left: 0.2rem;
    }
  }
</style>
