---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = [
  { href: `${base}/`, label: "DoraWolf", logo: true },
  { href: `${base}/about`, label: "About" },
  { href: `${base}/projects`, label: "Projects" },
  { href: `${base}/research`, label: "Research" },
  { href: `${base}/timeline`, label: "Timeline" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="nav">
  <div class="nav__inner container">
    <a href={items[0].href} class="nav__logo" aria-label="DoraWolf — home">
      <span>DoraWolf</span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          items.slice(1).map((item) => {
            const itemPath = item.href.replace(/\/$/, "") || "/";
            const active = path === itemPath;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={["nav__link", { "nav__link--active": active }]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }
  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1rem, 3vw, 2.2rem);
  }
  .nav__link {
    font-size: 0.92rem;
    color: var(--fg-muted);
    position: relative;
  }
  .nav__link:hover,
  .nav__link--active {
    color: var(--fg);
  }
  .nav__link--active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -22px;
    height: 1px;
    background: var(--fg);
  }
  @media (max-width: 540px) {
    .nav__list {
      gap: 1rem;
    }
    .nav__link {
      font-size: 0.85rem;
    }
  }
</style>
