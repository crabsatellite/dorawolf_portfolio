---
import site from "../../data/site.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = [
  { href: `${base}/about`, label: "About" },
  { href: `${base}/projects`, label: "Projects" },
  { href: `${base}/research`, label: "Research" },
  { href: `${base}/timeline`, label: "Timeline" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="nav">
  <div class="nav__inner container">
    <a href={`${base}/`} class="nav__logo" aria-label={`${site.name} — home`}>
      <span class="nav__logo-name">{site.name}</span>
      <span class="nav__logo-zh" aria-hidden="true">{site.fullNameZh}</span>
    </a>
    <nav aria-label="Primary" class="nav__primary">
      <ul class="nav__list">
        {
          items.map((item) => {
            const itemPath = item.href.replace(/\/$/, "") || "/";
            const active = path === itemPath || path.startsWith(itemPath + "/");
            return (
              <li>
                <a
                  href={item.href}
                  class:list={["nav__link", { "nav__link--active": active }]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg) 86%, transparent);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-height);
    gap: 1rem;
  }
  .nav__logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    color: var(--fg);
  }
  .nav__logo-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.012em;
    line-height: 1;
  }
  .nav__logo-zh {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1.1rem, 3.4vw, 2.4rem);
    align-items: center;
  }
  .nav__link {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    letter-spacing: 0.005em;
    color: var(--fg-muted);
    padding: 0.4rem 0;
    position: relative;
    transition: color var(--transition);
  }
  .nav__link:hover,
  .nav__link--active {
    color: var(--fg);
  }
  .nav__link--active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--fg);
  }
  @media (max-width: 540px) {
    .nav__logo-zh {
      display: none;
    }
    .nav__list {
      gap: 0.95rem;
    }
    .nav__link {
      font-size: 0.85rem;
    }
  }
</style>
