---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Picture from "~/components/Picture.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { t, type Lang } from "~/i18n/strings";
import {
  pickSummary,
  tr,
  typologyTranslations,
  locationTranslations,
  roleTranslations,
  statusTranslations,
} from "~/i18n/translateContent";
import fs from "node:fs";
import path from "node:path";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"projects">;
}
const { lang, entry } = Astro.props;
const { Content } = await entry.render();

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

let heroPreloads: { type: string; srcset: string; sizes: string }[] = [];
if (entry.data.hero) {
  const manifestPath = path.join(process.cwd(), "public", ".image-manifest.json");
  if (fs.existsSync(manifestPath)) {
    const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf-8"));
    const m = manifest[entry.data.hero];
    if (m) {
      for (const fmt of ["avif", "webp"] as const) {
        const widths = m.variants?.[fmt];
        if (!widths || !widths.length) continue;
        const srcset = widths
          .map(
            (w: number) =>
              `${base}${entry.data.hero!.replace(/\.[^.]+$/, `-${w}.${fmt}`)} ${w}w`
          )
          .join(", ");
        heroPreloads.push({ type: `image/${fmt}`, srcset, sizes: "100vw" });
      }
    }
  }
}

const all = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.slug === entry.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const titleDisplay =
  lang === "zh" && entry.data.titleZh ? entry.data.titleZh : entry.data.title;
const subtitle =
  lang === "zh" ? entry.data.title : entry.data.titleZh;

const note = lang === "zh" ? entry.data.noteZh : entry.data.note;
const noteLabel =
  lang === "zh" ? "工作室手记" : "Studio note";

// Tiny inline-markdown renderer for *italic* / **bold** within studio notes
function renderInline(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/\*\*([^*]+?)\*\*/g, "<strong>$1</strong>")
    .replace(/\*([^*]+?)\*/g, "<em>$1</em>");
}

const align = entry.data.align ?? "left";
const orderTwo = String(entry.data.order ?? 1).padStart(2, "0");

// Compact meta line — typology · location · role
const metaItems: string[] = [];
if (entry.data.typology)
  metaItems.push(tr(typologyTranslations, lang, entry.data.typology));
if (entry.data.location)
  metaItems.push(tr(locationTranslations, lang, entry.data.location));
if (entry.data.role)
  metaItems.push(tr(roleTranslations, lang, entry.data.role));
if (entry.data.status)
  metaItems.push(tr(statusTranslations, lang, entry.data.status));
---

<BaseLayout title={titleDisplay} description={entry.data.summary} lang={lang}>
  {
    heroPreloads.map((p) => (
      <link
        slot="head"
        rel="preload"
        as="image"
        type={p.type}
        imagesrcset={p.srcset}
        imagesizes={p.sizes}
      />
    ))
  }

  <article class:list={["case", `case--${align}`]}>
    <header class="case__head container">
      <div class="case__head-rail">
        <span class="case__seq" aria-hidden="true">{orderTwo}</span>
        <span class="case__rule" aria-hidden="true"></span>
        <p class="eyebrow case__eyebrow">
          {t(lang, "case.eyebrow", { year: String(entry.data.year) })}
        </p>
      </div>
      <h1 class="case__title">{titleDisplay}</h1>
      {subtitle && <p class="case__subtitle">{subtitle}</p>}
      <p class="case__attribution">{t(lang, "case.attribution")}</p>
    </header>

    {entry.data.hero && (
      <figure class="case__hero">
        <Picture
          src={entry.data.hero}
          alt={`${entry.data.title} — hero`}
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
        />
      </figure>
    )}

    {note && (
      <section class="case__note container">
        <div class="case__note-inner">
          <p class="eyebrow case__note-label">{noteLabel}</p>
          <blockquote class="case__note-text">
            <p set:html={renderInline(note)} />
          </blockquote>
        </div>
      </section>
    )}

    {metaItems.length > 0 && (
      <aside class="case__meta container">
        <dl>
          {entry.data.dateZh && (
            <div>
              <dt>{t(lang, "case.meta_date")}</dt>
              <dd>{entry.data.dateZh}</dd>
            </div>
          )}
          {entry.data.location && (
            <div>
              <dt>{t(lang, "case.meta_location")}</dt>
              <dd>{tr(locationTranslations, lang, entry.data.location)}</dd>
            </div>
          )}
          {entry.data.role && (
            <div>
              <dt>{t(lang, "case.meta_role")}</dt>
              <dd>{tr(roleTranslations, lang, entry.data.role)}</dd>
            </div>
          )}
          {entry.data.typology && (
            <div>
              <dt>{t(lang, "case.meta_typology")}</dt>
              <dd>{tr(typologyTranslations, lang, entry.data.typology)}</dd>
            </div>
          )}
        </dl>
      </aside>
    )}

    <section class="case__body">
      <div class="prose">
        <Content />
      </div>
    </section>

    {lang === "en" && (
      <p class="case__lang-note container">
        {t(lang, "case.body_note")}
      </p>
    )}

    <nav class="container case__nav" aria-label="Project navigation">
      <a href={`${langPrefix}/projects`} class="case__back">
        {t(lang, "case.back")}
      </a>
      <div class="case__pager">
        {prev && (
          <a
            href={`${langPrefix}/projects/${prev.slug}`}
            class="case__pager-item"
          >
            <span class="eyebrow">{t(lang, "case.prev")}</span>
            <span>
              {lang === "zh" && prev.data.titleZh
                ? prev.data.titleZh
                : prev.data.title}
            </span>
          </a>
        )}
        {next && (
          <a
            href={`${langPrefix}/projects/${next.slug}`}
            class="case__pager-item case__pager-item--right"
          >
            <span class="eyebrow">{t(lang, "case.next")}</span>
            <span>
              {lang === "zh" && next.data.titleZh
                ? next.data.titleZh
                : next.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* ============================================================
     Project case study — independent layout, not the plate
     template. Each project's `align` (left | right) flips the
     studio-note column and title alignment so the two halves
     of the case set carry a different center of gravity.
     ============================================================ */

  .case {
    --case-pad-top: var(--space-5);
  }

  .case__head {
    padding-top: var(--case-pad-top);
    padding-bottom: var(--space-3);
  }
  .case__head-rail {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .case__seq {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--fg-subtle);
    font-feature-settings: "tnum" 1;
  }
  .case__rule {
    height: 1px;
    background: var(--border);
  }
  .case__eyebrow {
    margin: 0;
    text-align: right;
  }

  .case__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.6rem, 8vw, 6.6rem);
    line-height: 0.96;
    letter-spacing: -0.032em;
    margin: var(--space-3) 0 0.4rem;
    max-width: 18ch;
  }
  .case--right .case__title {
    margin-left: auto;
    text-align: right;
  }
  .case__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    margin: 0 0 var(--space-3);
    letter-spacing: 0.005em;
  }
  .case--right .case__subtitle {
    text-align: right;
  }

  .case__attribution {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin: 0 0 var(--space-3);
  }
  .case--right .case__attribution {
    text-align: right;
  }

  .case__hero {
    margin: var(--space-3) 0 var(--space-4);
    padding: 0;
  }
  .case__hero :global(picture),
  .case__hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 1024px) {
    .case__hero :global(picture),
    .case__hero :global(img) {
      max-height: 84vh;
      object-fit: cover;
    }
  }

  /* ----- Studio note — magazine pull-quote ---------------------------- */
  .case__note {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .case__note-inner {
    position: relative;
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }
  @media (min-width: 880px) {
    .case__note-inner {
      grid-template-columns: repeat(12, 1fr);
      column-gap: clamp(1rem, 2vw, 2rem);
      align-items: start;
    }
  }
  .case--right .case__note-inner {
    margin-left: auto;
  }
  .case__note-label {
    margin: 0;
    align-self: start;
  }
  @media (min-width: 880px) {
    .case__note-label {
      grid-column: 1 / span 3;
      padding-top: 0.5rem;
    }
    .case--right .case__note-label {
      grid-column: 10 / span 3;
      text-align: right;
    }
  }
  .case__note-text {
    margin: 0;
    padding: 0;
    border: 0;
    position: relative;
  }
  @media (min-width: 880px) {
    .case__note-text {
      grid-column: 4 / span 8;
      max-width: 60ch;
    }
    .case--right .case__note-text {
      grid-column: 2 / span 8;
      justify-self: end;
    }
  }
  .case__note-text p {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(1.4rem, 2.4vw, 2.05rem);
    line-height: 1.38;
    letter-spacing: -0.012em;
    color: var(--fg);
    margin: 0;
    max-width: none;
    text-indent: 0;
  }
  .case__note-text p::before {
    content: "“";
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 300;
    color: var(--fg-subtle);
    margin-right: 0.05em;
    margin-left: -0.35em;
  }
  .case__note-text p::after {
    content: "”";
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 300;
    color: var(--fg-subtle);
    margin-left: 0.05em;
  }
  .case__note-text :global(em) {
    font-style: italic;
    color: var(--fg);
    font-weight: 400;
    box-shadow: inset 0 -1px 0 var(--border-strong);
  }
  .case__note-text :global(strong) {
    font-weight: 500;
    font-style: normal;
  }
  :global(html[lang^="zh"]) .case__note-text p {
    line-height: 1.55;
    letter-spacing: 0.005em;
    font-style: normal;
  }
  :global(html[lang^="zh"]) .case__note-text p::before,
  :global(html[lang^="zh"]) .case__note-text p::after {
    content: none;
  }

  /* ----- Compact meta strip ------------------------------------------ */
  .case__meta {
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .case__meta dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .case__meta dl > div {
    display: grid;
    gap: 0.35rem;
  }
  .case__meta dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin: 0;
  }
  .case__meta dd {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.25;
    color: var(--fg);
    margin: 0;
  }

  /* ----- Body — vertical-stack plates ------------------------------- */
  .case__body {
    padding: var(--space-5) 0 var(--space-4);
  }
  .prose {
    /* the plate / plate__intro / plate__media-grid styles in
       global.css carry the layout — the prose container only needs
       to provide vertical rhythm */
    display: block;
  }
  .prose :global(.plate) {
    padding: var(--space-5) 0;
  }
  .prose :global(.plate:first-child) {
    padding-top: 0;
  }
  /* loose intro before first <h2> reads like a stand-first paragraph */
  .prose :global(.plate--intro) {
    padding-bottom: var(--space-3);
  }
  .prose :global(.plate--intro .plate__intro p) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: var(--leading-snug);
    color: var(--fg);
  }
  :global(html[lang^="zh"]) .prose :global(.plate--intro .plate__intro p) {
    line-height: var(--leading-cn);
  }
  /* The plate--text-only sections (no images) deserve more breathing
     room since they have nothing else to anchor */
  .prose :global(.plate--text-only) {
    padding: var(--space-4) 0;
  }

  /* ----- Lang note + nav --------------------------------------------- */
  .case__lang-note {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
    text-align: center;
    padding: var(--space-2) 0;
    text-transform: uppercase;
  }
  .case__nav {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .case__back {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .case__back:hover {
    color: var(--fg);
  }
  .case__pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 720px) {
    .case__pager {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }
  }
  .case__pager-item {
    display: grid;
    gap: 0.5rem;
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
    color: var(--fg);
    transition: border-color var(--transition);
  }
  .case__pager-item:hover {
    border-top-color: var(--fg);
  }
  .case__pager-item span:nth-child(2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    letter-spacing: -0.012em;
    line-height: 1.2;
  }
  .case__pager-item--right {
    text-align: right;
  }
</style>
