---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { t, type Lang } from "~/i18n/strings";
import { loadSite, loadAbout } from "~/i18n/loadData";
import skills from "../../../data/skills.json";
import experience from "../../../data/experience.json";
import projectsRecord from "../../../data/projects-record.json";
import awards from "../../../data/awards.json";
import { expandRange } from "~/i18n/translateContent";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = loadSite(lang);
const about = loadAbout(lang);

const skillGroups = [
  { label: t(lang, "about.tools_modeling"), items: skills.modeling },
  { label: t(lang, "about.tools_rendering"), items: skills.rendering },
  { label: t(lang, "about.tools_drafting"), items: skills.drafting },
  { label: t(lang, "about.tools_graphics"), items: skills.graphics },
  { label: t(lang, "about.tools_ai"), items: skills.ai },
];

const cleanRecord = (rec: any) =>
  Object.fromEntries(Object.entries(rec).filter(([k]) => !k.startsWith("$")));
const records = projectsRecord.map(cleanRecord);
const exp = experience.map(cleanRecord);
const aw = awards.map(cleanRecord);

const pickName = (r: any) =>
  lang === "zh" ? r.zh || r.en : r.en || r.zh;
const pickOrg = (e: any) => (lang === "zh" ? e.orgZh || e.org : e.org);
const pickTitle = (e: any) =>
  lang === "zh" ? e.titleZh || e.title : e.title;
const pickAward = (a: any) =>
  lang === "zh" ? a.titleZh || a.title : a.title;
const pickPrize = (a: any) =>
  lang === "zh" ? a.prizeZh || a.prize : a.prize;
---

<BaseLayout title={t(lang, "about.title")} lang={lang}>
  <section class="section section--hero container about-hero">
    <p class="eyebrow">{t(lang, "about.eyebrow")}</p>
    <h1 class="about-hero__title">
      {site.fullName} &mdash; <em>{t(lang, "about.h1_role")}</em>{
        t(lang, "about.h1_after")
      }
    </h1>
    <p class="about-hero__zh">
      {about.education.degree}
    </p>
  </section>

  <section class="section container about-bio">
    <div class="about-bio__col">
      <h2 class="about-h2">{t(lang, "about.h2_bio")}</h2>
      <p class="about-bio__lead">{about.bio}</p>

      {(about as any).studio && (
        <div class="studio-card">
          <div class="studio-card__head">
            <p class="eyebrow">{(about as any).studio.founded}</p>
            <h3>{(about as any).studio.name}</h3>
          </div>
          <p class="studio-card__principal">
            {(about as any).studio.principal}
          </p>
          <p class="studio-card__based">{(about as any).studio.based}</p>
          <p class="studio-card__ethos">{(about as any).studio.ethos}</p>
          <ul class="studio-card__areas">
            {(about as any).studio.areas.map((a: string) => <li>{a}</li>)}
          </ul>
        </div>
      )}

      <h2 class="about-h2">{t(lang, "about.h2_education")}</h2>
      <p>
        <strong>{about.education.school}</strong> · {about.education.department}
        · {about.education.range}.
      </p>

      <h2 class="about-h2">{t(lang, "about.h2_practice")}</h2>
      <ul class="exp">
        {
          exp.map((e: any) => (
            <li class:list={["exp__item", `exp__item--${e.kind}`]}>
              <span class="exp__range">
                {expandRange(lang === "zh" ? e.rangeZh || e.range : e.range)}
              </span>
              <div class="exp__body">
                <p class="exp__title">{pickTitle(e)}</p>
                <p class="exp__org">{pickOrg(e)}</p>
                {(lang === "zh" ? e.noteZh || e.note : e.note) && (
                  <p class="exp__note">
                    {lang === "zh" ? e.noteZh || e.note : e.note}
                  </p>
                )}
              </div>
              <span class="exp__kind">
                {e.kind === "work"
                  ? t(lang, "about.kind_practice")
                  : t(lang, "about.kind_education")}
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="about-h2">{t(lang, "about.h2_record")}</h2>
      <ol class="proj">
        {
          records.map((r: any, i: number) => (
            <li class="proj__item">
              <span class="proj__no">{String(i + 1).padStart(2, "0")}</span>
              <span class="proj__year">{r.year}</span>
              <span class="proj__title">
                <span class="proj__en">{pickName(r)}</span>
                {lang === "en" && r.zh && (
                  <span class="proj__zh">{r.zh}</span>
                )}
              </span>
            </li>
          ))
        }
      </ol>

      <h2 class="about-h2">{t(lang, "about.h2_awards")}</h2>
      <ul class="awards">
        {
          aw.map((a: any) => (
            <li>
              <span class="awards__title">{pickAward(a)}</span>
              <span class="awards__prize">{pickPrize(a)}</span>
            </li>
          ))
        }
      </ul>

      <h2 class="about-h2">{t(lang, "about.h2_tools")}</h2>
      <dl class="tools">
        {
          skillGroups.map((g) => (
            <>
              <dt>{g.label}</dt>
              <dd>
                <ul class="chip-list">
                  {g.items.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </dd>
            </>
          ))
        }
      </dl>
    </div>

    <aside class="about-bio__side">
      <dl class="kv">
        <dt>{t(lang, "about.kv_based")}</dt>
        <dd>{site.location}</dd>
        <dt>{t(lang, "about.kv_languages")}</dt>
        <dd>{about.languages.join(" · ")}</dd>
        <dt>{t(lang, "about.kv_works_in")}</dt>
        <dd>{about.interests.join(" · ")}</dd>
        <dt>{t(lang, "about.kv_email")}</dt>
        <dd>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </dd>
      </dl>
    </aside>
  </section>
</BaseLayout>

<style>
  .about-hero__title em {
    font-style: italic;
    font-weight: 300;
  }
  .about-hero__zh {
    color: var(--fg-muted);
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-top: var(--space-2);
  }
  .about-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    margin: 0 0 var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--fg);
    display: inline-block;
  }
  .about-bio {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 880px) {
    .about-bio {
      grid-template-columns: 1.7fr 1fr;
      gap: var(--space-5);
    }
  }
  .about-bio__lead {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: var(--leading-snug);
    max-width: 56ch;
    margin: 0 0 var(--space-3);
    color: var(--fg);
  }

  .studio-card {
    margin: var(--space-3) 0 var(--space-4);
    padding: var(--space-3) var(--space-3);
    border-top: 2px solid var(--fg);
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
    max-width: 56ch;
  }
  .studio-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 0.8rem;
  }
  .studio-card__head h3 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    margin: 0;
    letter-spacing: -0.012em;
  }
  .studio-card__principal {
    margin: 0 0 0.2rem;
    font-weight: 500;
  }
  .studio-card__based {
    margin: 0 0 0.7rem;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .studio-card__ethos {
    margin: 0 0 0.7rem;
    font-style: italic;
    font-family: var(--font-display);
    color: var(--fg);
  }
  .studio-card__areas {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .studio-card__areas li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
  }
  :global(html[lang^="zh"]) .about-bio__lead {
    line-height: var(--leading-cn);
  }

  .kv {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.45rem 1rem;
    margin: 0;
    font-size: 0.92rem;
  }
  .kv dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 0.18rem;
  }
  .kv dd {
    margin: 0;
  }
  .kv a {
    border-bottom: 1px solid var(--border);
  }

  .exp {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exp__item {
    display: grid;
    grid-template-columns: 8.5rem 1fr 7rem;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .exp__item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .exp__range {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .exp__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.35rem;
  }
  .exp__org {
    margin: 0;
    color: var(--fg);
    font-weight: 500;
  }
  .exp__note {
    margin: 0.6rem 0 0;
    color: var(--fg-muted);
    max-width: 60ch;
  }
  .exp__kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    text-align: right;
  }
  @media (max-width: 720px) {
    .exp__item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .exp__kind {
      text-align: left;
      order: -1;
    }
  }

  .proj {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .proj__item {
    display: grid;
    grid-template-columns: 3rem 4rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .proj__item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .proj__no {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-subtle);
  }
  .proj__year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .proj__en {
    display: block;
    font-size: 0.98rem;
  }
  .proj__zh {
    display: block;
    color: var(--fg-muted);
    font-size: 0.85rem;
    margin-top: 0.18rem;
  }

  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .awards li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.4rem 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }
  .awards li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .awards__title {
    font-size: 0.96rem;
  }
  .awards__prize {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .tools {
    margin: 0;
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.6rem 1rem;
  }
  .tools dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 0.4rem;
  }
  .tools dd {
    margin: 0;
  }
  .chip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip-list li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
  }
</style>
