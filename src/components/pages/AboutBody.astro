---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { t, type Lang } from "~/i18n/strings";
import { loadSite, loadAbout } from "~/i18n/loadData";
import skills from "../../../data/skills.json";
import experience from "../../../data/experience.json";
import projectsRecord from "../../../data/projects-record.json";
import { expandRange } from "~/i18n/translateContent";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = loadSite(lang);
const about = loadAbout(lang);

const cleanRecord = (rec: any) =>
  Object.fromEntries(Object.entries(rec).filter(([k]) => !k.startsWith("$")));
const records = projectsRecord.map(cleanRecord);
const exp = experience.map(cleanRecord);

const pickName = (r: any) =>
  lang === "zh" ? r.zh || r.en : r.en || r.zh;
const pickOrg = (e: any) => (lang === "zh" ? e.orgZh || e.org : e.org);
const pickTitle = (e: any) =>
  lang === "zh" ? e.titleZh || e.title : e.title;
---

<BaseLayout title={t(lang, "about.title")} lang={lang}>
  <section class="section section--hero container about-hero">
    <p class="eyebrow">{t(lang, "about.eyebrow")}</p>
    <h1 class="about-hero__title">
      {site.fullName} &mdash; <em>{t(lang, "about.h1_role")}</em>{
        t(lang, "about.h1_after")
      }
    </h1>
  </section>

  <section class="section container about-bio">
    <div class="about-bio__col">
      <h2 class="about-h2">{t(lang, "about.h2_bio")}</h2>
      <p class="about-bio__lead">{about.bio}</p>

      {(about as any).studio && (
        <div class="studio-card">
          <div class="studio-card__head">
            <p class="eyebrow">{(about as any).studio.founded}</p>
            <h3>{(about as any).studio.name}</h3>
          </div>
          <p class="studio-card__principal">
            {(about as any).studio.principal}
          </p>
          <p class="studio-card__based">{(about as any).studio.based}</p>
          <p class="studio-card__ethos">{(about as any).studio.ethos}</p>
          <ul class="studio-card__areas">
            {(about as any).studio.areas.map((a: string) => <li>{a}</li>)}
          </ul>
        </div>
      )}

      <h2 class="about-h2">{t(lang, "about.h2_practice")}</h2>
      <ul class="exp">
        {
          exp.map((e: any) => (
            <li class="exp__item">
              <span class="exp__range">
                {expandRange(lang === "zh" ? e.rangeZh || e.range : e.range)}
              </span>
              <div class="exp__body">
                <p class="exp__title">{pickTitle(e)}</p>
                <p class="exp__org">{pickOrg(e)}</p>
                {(lang === "zh" ? e.noteZh || e.note : e.note) && (
                  <p class="exp__note">
                    {lang === "zh" ? e.noteZh || e.note : e.note}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <h2 class="about-h2">{t(lang, "about.h2_record")}</h2>
      <ol class="proj">
        {
          records.map((r: any, i: number) => (
            <li class="proj__item">
              <span class="proj__no">{String(i + 1).padStart(2, "0")}</span>
              <span class="proj__year">{r.year}</span>
              <span class="proj__title">
                <span class="proj__en">{pickName(r)}</span>
                {lang === "en" && r.zh && (
                  <span class="proj__zh">{r.zh}</span>
                )}
              </span>
            </li>
          ))
        }
      </ol>

      <h2 class="about-h2">{t(lang, "about.h2_tools")}</h2>
      <ul class="chip-list tools-kit">
        {skills.kit.map((s: string) => <li>{s}</li>)}
      </ul>
    </div>

    <aside class="about-bio__side">
      <dl class="kv">
        <dt>{t(lang, "about.kv_based")}</dt>
        <dd>{site.location}</dd>
        <dt>{t(lang, "about.kv_languages")}</dt>
        <dd>{about.languages.join(" · ")}</dd>
      </dl>
    </aside>
  </section>
</BaseLayout>

<style>
  .about-hero__title {
    font-weight: 300;
    letter-spacing: -0.032em;
  }
  .about-hero__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--fg-muted);
  }
  .about-h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    letter-spacing: -0.02em;
    margin: var(--space-5) 0 var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    display: block;
  }
  .about-h2:first-of-type {
    margin-top: 0;
  }
  .about-h2::before {
    content: "";
    display: block;
    width: 2.4rem;
    height: 1px;
    background: var(--fg);
    margin-top: -1.5rem;
    margin-bottom: 1.5rem;
  }
  .about-bio {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 880px) {
    .about-bio {
      grid-template-columns: 1.7fr 1fr;
      gap: var(--space-5);
    }
  }
  .about-bio__lead {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: var(--leading-snug);
    max-width: 56ch;
    margin: 0 0 var(--space-3);
    color: var(--fg);
  }

  .studio-card {
    margin: var(--space-3) 0 var(--space-4);
    padding: var(--space-4) var(--space-4);
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
    max-width: 60ch;
  }
  .studio-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }
  .studio-card__head h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    margin: 0;
    letter-spacing: -0.022em;
    line-height: 1;
  }
  .studio-card__principal {
    margin: 0 0 0.2rem;
    font-weight: 500;
  }
  .studio-card__based {
    margin: 0 0 1rem;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .studio-card__ethos {
    margin: 0 0 1rem;
    font-style: italic;
    font-weight: 300;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.45;
    color: var(--fg);
  }
  :global(html[lang^="zh"]) .studio-card__ethos {
    font-style: normal;
    line-height: var(--leading-cn);
  }
  .studio-card__areas {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .studio-card__areas li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.22rem 0.55rem;
    border: 1px solid var(--border);
    color: var(--fg-muted);
  }
  :global(html[lang^="zh"]) .about-bio__lead {
    line-height: var(--leading-cn);
  }

  .kv {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.45rem 1rem;
    margin: 0;
    font-size: 0.92rem;
  }
  .kv dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 0.18rem;
  }
  .kv dd {
    margin: 0;
  }
  .kv a {
    border-bottom: 1px solid var(--border);
  }

  .exp {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exp__item {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .exp__item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .exp__range {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .exp__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.35rem;
  }
  .exp__org {
    margin: 0;
    color: var(--fg);
    font-weight: 500;
  }
  .exp__note {
    margin: 0.6rem 0 0;
    color: var(--fg-muted);
    max-width: 60ch;
  }
  @media (max-width: 720px) {
    .exp__item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  .proj {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: var(--space-4);
  }
  @media (min-width: 720px) {
    .proj {
      columns: 2;
    }
  }
  .proj__item {
    display: grid;
    grid-template-columns: 2.4rem 3.5rem 1fr;
    gap: 0.8rem;
    padding: 0.55rem 0;
    align-items: baseline;
    break-inside: avoid;
  }
  .proj__no {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-subtle);
    font-feature-settings: "tnum" 1;
  }
  .proj__year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .proj__en {
    display: block;
    font-size: 0.94rem;
    line-height: 1.35;
  }
  .proj__zh {
    display: block;
    color: var(--fg-muted);
    font-size: 0.82rem;
    margin-top: 0.18rem;
  }

  .chip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip-list li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
  }
  .tools-kit {
    margin-top: 0.2rem;
  }
</style>
