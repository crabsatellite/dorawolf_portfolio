---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Picture from "~/components/Picture.astro";
import { getCollection } from "astro:content";
import { t, type Lang } from "~/i18n/strings";
import { loadSite } from "~/i18n/loadData";
import {
  pickSummary,
  tr,
  typologyTranslations,
  locationTranslations,
  expandRange,
} from "~/i18n/translateContent";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = loadSite(lang);

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const featured = projects[0];
const rest = projects.slice(1);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

const heroLines = t(lang, "home.hero") as readonly string[];
const yearRange = expandRange(site.yearRange);

// Build cursor-follow preview src for each project list row.
function previewSrc(p: any): string | null {
  return p.data.hero ? `${base}${p.data.hero}` : null;
}
---

<BaseLayout title={site.name} lang={lang}>
  <section class="section section--hero container hero">
    <span class="hero__backdrop" aria-hidden="true">{yearRange.split(" ").pop()}</span>
    <div class="hero__head">
      <p class="eyebrow">
        {t(lang, "home.eyebrow", { range: yearRange })}
      </p>
      <h1 class="hero__title">
        {
          lang === "zh" ? (
            <>
              <span class="hero__line hero__line--prose" style="--i:0">
                {heroLines[0]}
              </span>
              <span class="hero__line hero__line--mark" style="--i:1">
                <span class="hero__index" aria-hidden="true">01</span>
                <span class="hero__keyword">{heroLines[1]}</span>
              </span>
              <span class="hero__line hero__line--mark" style="--i:2">
                <span class="hero__index" aria-hidden="true">02</span>
                <span class="hero__keyword">{heroLines[2]}</span>
              </span>
              <span class="hero__line hero__line--prose" style="--i:3">
                {heroLines[3]}。
              </span>
            </>
          ) : (
            <>
              <span class="hero__line hero__line--prose" style="--i:0">
                {heroLines[0]}
              </span>
              <span class="hero__line hero__line--mark" style="--i:1">
                <span class="hero__index" aria-hidden="true">01</span>
                <span class="hero__keyword">{heroLines[1]}</span>
              </span>
              <span class="hero__line hero__line--mark" style="--i:2">
                <span class="hero__index" aria-hidden="true">02</span>
                <span class="hero__keyword">{heroLines[2]}</span>
              </span>
              <span class="hero__line hero__line--prose" style="--i:3">
                {heroLines[3]}
              </span>
            </>
          )
        }
      </h1>
    </div>
    <div class="hero__lede">
      <p>
        {
          t(lang, "home.lede", {
            fullName: site.fullName,
            name: site.name,
            location: site.location,
          })
        }
      </p>
      <p class="hero__cta">
        <a class="arrow-link" href={`${langPrefix}/projects`}>
          {t(lang, "home.cta_view_projects")}
        </a>
      </p>
    </div>
  </section>

  {
    featured && (
      <section class="section featured">
        <a
          href={`${langPrefix}/projects/${featured.slug}`}
          class="featured__link"
        >
          <div class="featured__image">
            {featured.data.hero ? (
              <Picture
                src={featured.data.hero}
                alt={featured.data.title}
                loading="eager"
                fetchpriority="high"
                sizes="100vw"
              />
            ) : null}
          </div>
          <div class="container featured__caption">
            <p class="eyebrow">
              {t(lang, "home.featured_eyebrow", { year: featured.data.year })}
            </p>
            <h2 class="featured__title">
              {lang === "zh" && featured.data.titleZh
                ? featured.data.titleZh
                : featured.data.title}
            </h2>
            {lang === "en" && featured.data.titleZh && (
              <p class="featured__zh">{featured.data.titleZh}</p>
            )}
            <p class="featured__summary">{pickSummary(lang, featured.data)}</p>
            <span class="arrow-link">{t(lang, "home.featured_cta")}</span>
          </div>
        </a>
      </section>
    )
  }

  <section class="section container">
    <header class="section-head">
      <div>
        <p class="eyebrow">{t(lang, "home.section_index_eyebrow")}</p>
        <h2>{t(lang, "home.section_index_title")}</h2>
      </div>
      <a
        class="arrow-link arrow-link--mono"
        href={`${langPrefix}/projects`}
      >
        {t(lang, "home.section_all_link", { count: projects.length })}
      </a>
    </header>
    <ol class="project-list">
      {
        rest.map((p) => {
          const meta = [
            tr(typologyTranslations, lang, p.data.typology),
            tr(locationTranslations, lang, p.data.location),
          ]
            .filter(Boolean)
            .join(" · ");
          const ps = previewSrc(p);
          return (
            <li class="project-item">
              <a
                href={`${langPrefix}/projects/${p.slug}`}
                data-preview={ps}
              >
                <span class="project-item__thumb" aria-hidden="true">
                  {p.data.hero && (
                    <Picture
                      src={p.data.hero}
                      alt=""
                      loading="lazy"
                      sizes="96px"
                    />
                  )}
                </span>
                <span class="project-item__year">{p.data.year}</span>
                <span class="project-item__title">
                  <span class="project-item__title-en">
                    {lang === "zh" && p.data.titleZh
                      ? p.data.titleZh
                      : p.data.title}
                  </span>
                  {lang === "en" && p.data.titleZh && (
                    <span class="project-item__title-zh">{p.data.titleZh}</span>
                  )}
                </span>
                <span class="project-item__meta">{meta}</span>
                <span class="project-item__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="section container threads-section">
    <header class="section-head">
      <div>
        <p class="eyebrow">{t(lang, "home.section_threads_eyebrow")}</p>
        <h2>{t(lang, "home.section_threads_title")}</h2>
      </div>
    </header>
    <div class="threads">
      <article>
        <p class="thread__no">01</p>
        <h3>{t(lang, "home.thread_1_title")}</h3>
        <p>{t(lang, "home.thread_1_body")}</p>
      </article>
      <article>
        <p class="thread__no">02</p>
        <h3>{t(lang, "home.thread_2_title")}</h3>
        <p>{t(lang, "home.thread_2_body")}</p>
      </article>
      <article>
        <p class="thread__no">03</p>
        <h3>{t(lang, "home.thread_3_title")}</h3>
        <p>{t(lang, "home.thread_3_body")}</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    position: relative;
    isolation: isolate;
  }
  @media (min-width: 980px) {
    .hero {
      grid-template-columns: 1.55fr 1fr;
      gap: var(--space-6);
      align-items: end;
    }
  }

  /* Year backdrop, upper-right corner */
  .hero__backdrop {
    position: absolute;
    top: -0.18em;
    right: 0;
    font-family: var(--font-display);
    font-weight: 200;
    font-size: clamp(7rem, 18vw, 15rem);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    letter-spacing: -0.04em;
    z-index: -1;
    user-select: none;
    pointer-events: none;
    font-feature-settings: "tnum" 1, "lnum" 1;
  }
  @media (max-width: 720px) {
    .hero__backdrop { display: none; }
  }

  .hero__head {
    position: relative;
  }
  .hero__title {
    margin: 0;
    display: block;
    letter-spacing: -0.022em;
  }
  .hero__line {
    display: block;
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    animation: hero-rise 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i, 0) * 90ms + 220ms);
  }
  .no-js .hero__line {
    opacity: 1;
    transform: none;
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__line {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Prose lines: lighter weight than marked lines */
  .hero__line--prose {
    font-weight: 300;
    color: var(--fg-muted);
  }

  /* Marked lines: side-rail ordinal at desktop, regular-weight keyword. */
  .hero__line--mark {
    position: relative;
    font-weight: 400;
    color: var(--fg);
  }
  @media (min-width: 720px) {
    .hero__line--mark {
      padding-left: 3.6rem;
    }
  }

  .hero__index {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.18em;
    color: var(--fg-subtle);
    display: inline-block;
    vertical-align: 0.55em;
    margin-right: 0.7rem;
  }
  @media (min-width: 720px) {
    .hero__index {
      position: absolute;
      left: 0;
      top: 0.5em;
      width: 2.6rem;
      margin-right: 0;
    }
    .hero__index::after {
      content: "";
      position: absolute;
      left: 1.6rem;
      top: 0.55em;
      width: 0.8rem;
      height: 1px;
      background: var(--border-strong);
      opacity: 0.55;
    }
  }

  .hero__keyword {
    position: relative;
    display: inline-block;
    color: var(--fg);
    letter-spacing: -0.024em;
  }
  .hero__keyword::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06em;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left center;
    animation: hero-rule 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i, 0) * 90ms + 700ms);
  }
  .no-js .hero__keyword::after {
    transform: none;
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__keyword::after {
      transform: none;
      animation: none;
    }
  }
  @keyframes hero-rule {
    to {
      transform: scaleX(1);
    }
  }

  .hero__lede p {
    font-family: var(--font-display);
    font-size: var(--text-lede);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
    max-width: 42ch;
  }
  .hero__cta {
    margin-top: var(--space-3);
  }

  .featured {
    border-top: 1px solid var(--border);
    padding: var(--space-5) 0 0;
  }
  .featured__link {
    display: block;
    color: inherit;
  }
  .featured__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .featured__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.6, 0.18, 1);
  }
  .featured__link:hover .featured__image :global(img) {
    transform: scale(1.025);
  }
  .featured__caption {
    padding-top: var(--space-3);
    padding-bottom: var(--space-2);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    max-width: var(--max-w);
  }
  .featured__title {
    font-size: var(--text-h2-lg);
    margin: 0;
  }
  .featured__zh {
    font-family: var(--font-display);
    color: var(--fg-muted);
    margin: 0;
  }
  .featured__summary {
    margin: 0.6rem 0 1.2rem;
    max-width: 60ch;
    color: var(--fg);
  }
  @media (min-width: 980px) {
    .featured__caption {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .featured__title {
      grid-column: 1 / 2;
    }
    .featured__zh {
      grid-column: 1 / 2;
    }
    .featured__summary {
      grid-column: 2 / 3;
      grid-row: 1 / span 3;
      align-self: end;
    }
    .featured__caption .arrow-link {
      grid-column: 2 / 3;
      align-self: start;
    }
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .section-head h2 {
    margin: 0;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-item {
    border-top: 1px solid var(--border);
  }
  .project-item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .project-item a {
    display: grid;
    grid-template-columns: 4.5rem 4.5rem 1fr auto 1.5rem;
    align-items: center;
    gap: 1.4rem;
    padding: 1.1rem 0;
    transition: padding-left var(--transition);
  }
  .project-item a:hover {
    padding-left: 0.5rem;
  }
  .project-item__thumb {
    display: block;
    width: 4.5rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-elevated);
    align-self: center;
  }
  .project-item__thumb :global(picture),
  .project-item__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.6, 0.18, 1);
  }
  .project-item a:hover .project-item__thumb :global(img) {
    transform: scale(1.06);
  }
  .project-item__year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    align-self: center;
  }
  .project-item__title {
    align-self: center;
  }
  .project-item__title-en {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-h3);
    line-height: var(--leading-tight);
    letter-spacing: -0.012em;
  }
  .project-item__title-zh {
    display: block;
    color: var(--fg-muted);
    font-family: var(--font-display);
    font-size: var(--text-md);
    margin-top: 0.3rem;
  }
  .project-item__meta {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: right;
    max-width: 22ch;
  }
  .project-item__arrow {
    font-family: var(--font-mono);
    color: var(--fg-subtle);
  }
  @media (max-width: 720px) {
    .project-item a {
      grid-template-columns: 3.5rem 1fr;
      grid-template-areas:
        "thumb title"
        "thumb meta";
      gap: 0.3rem 1rem;
      padding: 1rem 0;
      align-items: center;
    }
    .project-item__thumb {
      grid-area: thumb;
      width: 3.5rem;
    }
    .project-item__year {
      display: none;
    }
    .project-item__title {
      grid-area: title;
    }
    .project-item__title-zh {
      display: none;
    }
    .project-item__meta {
      grid-area: meta;
      text-align: left;
      margin-top: 0.1rem;
      max-width: none;
      font-size: var(--text-2xs);
    }
    .project-item__arrow {
      display: none;
    }
  }

  .threads-section {
    border-top: 1px solid var(--border);
  }
  .threads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .threads article {
    border-top: 1px solid var(--fg);
    padding-top: 1.1rem;
  }
  .thread__no {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.18em;
    color: var(--fg-subtle);
    margin: 0 0 0.55rem;
  }
  .threads h3 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--text-base);
    letter-spacing: 0;
    margin-bottom: 0.6rem;
  }
  .threads p {
    color: var(--fg-muted);
    margin: 0;
  }
</style>
