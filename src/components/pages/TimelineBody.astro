---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { t, type Lang } from "~/i18n/strings";
import experience from "../../../data/experience.json";
import { expandRange, tr, locationTranslations } from "~/i18n/translateContent";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const cleanRecord = (rec: any) =>
  Object.fromEntries(Object.entries(rec).filter(([k]) => !k.startsWith("$")));
const entries = experience.map(cleanRecord);

const pickTitle = (e: any) =>
  lang === "zh" ? e.titleZh || e.title : e.title;
const pickOrg = (e: any) => (lang === "zh" ? e.orgZh || e.org : e.org);
const pickRange = (e: any) =>
  expandRange(lang === "zh" ? e.rangeZh || e.range : e.range);
const pickNote = (e: any) => (lang === "zh" ? e.noteZh || e.note : e.note);
const h1 = t(lang, "timeline.h1") as readonly string[];
const lede = t(lang, "timeline.lede");
---

<BaseLayout title={t(lang, "timeline.title")} lang={lang}>
  <section class="section section--hero container">
    <p class="eyebrow">{t(lang, "timeline.eyebrow")}</p>
    <h1>{h1[0]}<br />{h1[1]}</h1>
    {lede && <p class="timeline-lede">{lede}</p>}
  </section>

  <section class="section container">
    <ol class="timeline">
      {
        entries.map((e: any) => (
          <li class="t-item">
            <span class="t-item__range">{pickRange(e)}</span>
            <div class="t-item__body">
              <h3 class="t-item__title">{pickTitle(e)}</h3>
              <p class="t-item__org">
                {pickOrg(e)}
                {e.location && (
                  <span class="t-item__loc">
                    {" "}· {tr(locationTranslations, lang, e.location)}
                  </span>
                )}
              </p>
              {pickNote(e) && <p class="t-item__notes">{pickNote(e)}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .timeline-lede {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
    max-width: 56ch;
    margin: var(--space-3) 0 0;
  }
  :global(html[lang^="zh"]) .timeline-lede {
    line-height: var(--leading-cn);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .t-item {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .t-item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .t-item__range {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
    font-feature-settings: "tnum" 1;
  }
  .t-item__title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 0 0 0.3rem;
  }
  .t-item__org {
    margin: 0;
    color: var(--fg);
  }
  .t-item__loc {
    color: var(--fg-muted);
  }
  .t-item__notes {
    margin: 0.7rem 0 0;
    color: var(--fg-muted);
    max-width: 60ch;
  }
  @media (max-width: 720px) {
    .t-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
