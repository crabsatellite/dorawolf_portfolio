---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Picture from "~/components/Picture.astro";
import { getCollection } from "astro:content";
import { t, type Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;
---

<BaseLayout title={t(lang, "projects.title")} lang={lang}>
  <section class="section section--hero container projects-hero">
    <p class="eyebrow">{t(lang, "projects.eyebrow", { count: projects.length })}</p>
    <h1>{t(lang, "projects.h1")}</h1>
    <p class="lede">{t(lang, "projects.lede")}</p>
  </section>

  <section class="section">
    <ol class="plates">
      {
        projects.map((p, i) => (
          <li class="plate">
            <a href={`${langPrefix}/projects/${p.slug}`} class="plate__link">
              <div class="container plate__inner">
                <span class="plate__no">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="plate__copy">
                  <p class="eyebrow">
                    {p.data.year}
                    {p.data.typology && ` · ${p.data.typology}`}
                    {p.data.location && ` · ${p.data.location}`}
                  </p>
                  <h2 class="plate__title">
                    {lang === "zh" && p.data.titleZh
                      ? p.data.titleZh
                      : p.data.title}
                  </h2>
                  {lang === "en" && p.data.titleZh && (
                    <p class="plate__zh">{p.data.titleZh}</p>
                  )}
                  <p class="plate__summary">{p.data.summary}</p>
                  <span class="arrow-link">{t(lang, "projects.read")}</span>
                </div>
                <div class="plate__image">
                  {p.data.hero && (
                    <Picture
                      src={p.data.hero}
                      alt={p.data.title}
                      loading={i < 2 ? "eager" : "lazy"}
                      fetchpriority={i === 0 ? "high" : undefined}
                      sizes="(min-width: 1440px) 720px, (min-width: 880px) 50vw, 100vw"
                    />
                  )}
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .projects-hero h1 {
    margin-bottom: var(--space-2);
  }
  .lede {
    font-family: var(--font-display);
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: var(--leading-snug);
    max-width: 56ch;
  }

  .plates {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plate {
    border-top: 1px solid var(--border);
  }
  .plate:last-child {
    border-bottom: 1px solid var(--border);
  }
  .plate__link {
    display: block;
    color: inherit;
    transition: background var(--transition);
  }
  .plate__link:hover {
    background: var(--bg-elevated);
  }
  .plate__inner {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-4) 0;
    align-items: start;
  }
  @media (min-width: 880px) {
    .plate__inner {
      grid-template-columns: 4.5rem minmax(0, 1.05fr) minmax(0, 1.05fr);
      gap: var(--space-4);
      padding: var(--space-5) 0;
    }
  }
  .plate__no {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--fg-subtle);
    padding-top: 0.4rem;
  }
  .plate__copy {
    max-width: 48ch;
  }
  .plate__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    margin: 0 0 0.3rem;
    letter-spacing: -0.018em;
    line-height: var(--leading-tight);
  }
  .plate__zh {
    font-family: var(--font-display);
    color: var(--fg-muted);
    font-size: 1rem;
    margin: 0 0 0.9rem;
  }
  .plate__summary {
    color: var(--fg);
    margin: 0 0 1.2rem;
  }
  .plate__image {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }
  .plate__image :global(picture),
  .plate__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.2, 0.6, 0.18, 1);
  }
  .plate__link:hover .plate__image :global(img) {
    transform: scale(1.03);
  }
  @media (max-width: 879px) {
    .plate__image {
      aspect-ratio: 16 / 10;
      grid-column: 1 / -1;
      margin-top: var(--space-2);
    }
    .plate__copy {
      grid-column: 2 / -1;
    }
  }
</style>
