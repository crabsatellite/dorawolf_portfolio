---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { t, type Lang } from "~/i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = lang === "en" ? `${base}/en/` : `${base}/`;
const h1 = t(lang, "404.h1") as readonly string[];
---

<BaseLayout title="404" lang={lang}>
  <section class="section section--hero container nf">
    <p class="eyebrow">{t(lang, "404.eyebrow")}</p>
    <h1>{h1[0]}<br />{h1[1]}</h1>
    <p class="nf__lede">{t(lang, "404.lede")}</p>
    <a class="arrow-link" href={home}>{t(lang, "404.back")}</a>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 60vh;
  }
  .nf__lede {
    font-family: var(--font-display);
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: var(--leading-snug);
    max-width: 56ch;
    margin: var(--space-3) 0 var(--space-3);
  }
</style>
