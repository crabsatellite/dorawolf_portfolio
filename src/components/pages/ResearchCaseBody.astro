---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Picture from "~/components/Picture.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { t, type Lang } from "~/i18n/strings";
import fs from "node:fs";
import path from "node:path";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"research">;
}
const { lang, entry } = Astro.props;

let Content: Awaited<ReturnType<CollectionEntry<"research">["render"]>>["Content"];
let hasEnBody = false;
if (lang === "en") {
  try {
    const enEntry = await getEntry("researchEn", entry.slug);
    if (enEntry) {
      Content = (await enEntry.render()).Content;
      hasEnBody = true;
    }
  } catch {
    /* no en entry — fall back below */
  }
}
if (!Content!) {
  Content = (await entry.render()).Content;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

let heroPreloads: { type: string; srcset: string; sizes: string }[] = [];
if (entry.data.hero) {
  const manifestPath = path.join(process.cwd(), "public", ".image-manifest.json");
  if (fs.existsSync(manifestPath)) {
    const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf-8"));
    const m = manifest[entry.data.hero];
    if (m) {
      for (const fmt of ["avif", "webp"] as const) {
        const widths = m.variants?.[fmt];
        if (!widths || !widths.length) continue;
        const srcset = widths
          .map(
            (w: number) =>
              `${base}${entry.data.hero!.replace(/\.[^.]+$/, `-${w}.${fmt}`)} ${w}w`
          )
          .join(", ");
        heroPreloads.push({ type: `image/${fmt}`, srcset, sizes: "100vw" });
      }
    }
  }
}

const all = (await getCollection("research", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.slug === entry.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const titleDisplay =
  lang === "zh" && entry.data.titleZh ? entry.data.titleZh : entry.data.title;
const subtitle = lang === "zh" ? entry.data.title : entry.data.titleZh;

const blurb =
  lang === "zh" && entry.data.blurbZh ? entry.data.blurbZh : entry.data.blurb;

const orderTwo = String(entry.data.order ?? 1).padStart(2, "0");
---

<BaseLayout title={titleDisplay} description={entry.data.blurb} lang={lang}>
  {
    heroPreloads.map((p) => (
      <link
        slot="head"
        rel="preload"
        as="image"
        type={p.type}
        imagesrcset={p.srcset}
        imagesizes={p.sizes}
      />
    ))
  }

  <article class="case">
    {entry.data.hero && (
      <figure class="case__hero">
        <Picture
          src={entry.data.hero}
          alt={`${entry.data.title} — cover`}
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
        />
      </figure>
    )}

    <header class="case__head container">
      <div class="case__index">
        <span class="case__index-no">{orderTwo}</span>
        <span class="case__index-rule" aria-hidden="true"></span>
        <span class="case__index-eyebrow">{t(lang, "research.case_eyebrow")}</span>
      </div>

      <div class="case__head-grid">
        <div class="case__head-main">
          <h1 class="case__title">{titleDisplay}</h1>
          {subtitle && <p class="case__subtitle">{subtitle}</p>}
          {blurb && <p class="case__note">{blurb}</p>}
        </div>

        <dl class="case__data">
          <div>
            <dt>{t(lang, "research.case_eyebrow")}</dt>
            <dd>{t(lang, "research.attribution")}</dd>
          </div>
        </dl>
      </div>
    </header>

    <section
      class:list={[
        "case__body",
        lang === "en" && !hasEnBody && "case__body--visual",
      ]}
    >
      <div class="prose">
        <Content />
      </div>
    </section>

    {lang === "en" && !hasEnBody && (
      <p class="case__lang-note container">
        {t(lang, "research.body_note")}
      </p>
    )}

    <nav class="container case__nav" aria-label="Research navigation">
      <a href={`${langPrefix}/research`} class="case__back">
        {t(lang, "research.back")}
      </a>
      <div class="case__pager">
        {prev && (
          <a
            href={`${langPrefix}/research/${prev.slug}`}
            class="case__pager-item"
          >
            <span class="eyebrow">{t(lang, "research.prev")}</span>
            <span>
              {lang === "zh" && prev.data.titleZh
                ? prev.data.titleZh
                : prev.data.title}
            </span>
          </a>
        )}
        {next && (
          <a
            href={`${langPrefix}/research/${next.slug}`}
            class="case__pager-item case__pager-item--right"
          >
            <span class="eyebrow">{t(lang, "research.next")}</span>
            <span>
              {lang === "zh" && next.data.titleZh
                ? next.data.titleZh
                : next.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* Mirror of ProjectCaseBody — hero-first, two-column header, divider,
     plate body, pager. The selectors are scoped to this component so
     research stays self-contained even though it shares class names. */

  .case__hero {
    margin: 0;
    padding: 0;
    background: var(--bg-elevated);
  }
  .case__hero :global(picture),
  .case__hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 720px) {
    .case__hero :global(picture),
    .case__hero :global(img) {
      max-height: 78vh;
      object-fit: cover;
    }
  }

  .case__head {
    padding-top: var(--space-5);
    padding-bottom: var(--space-3);
  }

  .case__index {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    font-feature-settings: "tnum" 1;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }
  .case__index-no {
    color: var(--fg);
    letter-spacing: 0.1em;
  }
  .case__index-rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .case__head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 880px) {
    .case__head-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-5);
      align-items: start;
    }
  }

  .case__head-main {
    max-width: 60ch;
  }

  .case__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-h2-lg);
    line-height: 1.05;
    letter-spacing: -0.022em;
    margin: 0;
    color: var(--fg);
    text-wrap: balance;
  }

  .case__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: var(--text-lede);
    line-height: 1.35;
    color: var(--fg-muted);
    margin: 0.7rem 0 0;
  }
  :global(html[lang^="zh"]) .case__subtitle {
    font-style: normal;
  }

  .case__note {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: var(--text-lede);
    line-height: var(--leading-snug);
    color: var(--fg);
    margin: var(--space-3) 0 0;
    max-width: 56ch;
  }
  :global(html[lang^="zh"]) .case__note {
    font-style: normal;
    line-height: var(--leading-cn);
    letter-spacing: 0.005em;
  }

  .case__data {
    margin: 0;
    padding: 0;
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  @media (min-width: 880px) {
    .case__data {
      border-top: 1px solid var(--fg);
    }
  }
  .case__data > div {
    display: grid;
    grid-template-columns: minmax(5.5rem, 7rem) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
    margin: 0;
  }
  .case__data dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin: 0;
  }
  .case__data dd {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1.3;
    color: var(--fg);
    margin: 0;
  }

  .case__body {
    padding: var(--space-5) 0 var(--space-4);
    border-top: 1px solid var(--border);
  }
  .prose {
    display: block;
  }
  .prose :global(.plate) {
    padding: var(--space-5) 0;
  }
  .prose :global(.plate:first-child) {
    padding-top: 0;
  }
  .prose :global(.plate--intro) {
    padding-bottom: var(--space-3);
  }
  .prose :global(.plate--intro .plate__intro p) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-lede-lg);
    line-height: var(--leading-snug);
    color: var(--fg);
  }
  :global(html[lang^="zh"]) .prose :global(.plate--intro .plate__intro p) {
    line-height: var(--leading-cn);
  }
  .prose :global(.plate--text-only) {
    padding: var(--space-4) 0;
  }

  .case__lang-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
    text-align: center;
    padding: var(--space-2) 0;
    text-transform: uppercase;
  }

  .case__nav {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .case__back {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .case__back:hover {
    color: var(--fg);
  }
  .case__pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 720px) {
    .case__pager {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }
  }
  .case__pager-item {
    display: grid;
    gap: 0.5rem;
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
    color: var(--fg);
    transition: border-color var(--transition);
  }
  .case__pager-item:hover {
    border-top-color: var(--fg);
  }
  .case__pager-item span:nth-child(2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-lede-lg);
    letter-spacing: -0.012em;
    line-height: 1.2;
  }
  .case__pager-item--right {
    text-align: right;
  }
</style>
