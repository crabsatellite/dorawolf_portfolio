---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Picture from "~/components/Picture.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { t, type Lang } from "~/i18n/strings";
import fs from "node:fs";
import path from "node:path";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"research">;
}
const { lang, entry } = Astro.props;

// English locale: prefer the translated body in researchEn/<slug>.md;
// otherwise fall back to the Chinese body rendered inside
// .case__body--visual (image-grids only). Mirrors ProjectCaseBody.
let Content: Awaited<ReturnType<CollectionEntry<"research">["render"]>>["Content"];
let hasEnBody = false;
if (lang === "en") {
  try {
    const enEntry = await getEntry("researchEn", entry.slug);
    if (enEntry) {
      Content = (await enEntry.render()).Content;
      hasEnBody = true;
    }
  } catch {
    /* no en entry — fall back below */
  }
}
if (!Content!) {
  Content = (await entry.render()).Content;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const langPrefix = lang === "en" ? `${base}/en` : base;

let heroPreloads: { type: string; srcset: string; sizes: string }[] = [];
if (entry.data.hero) {
  const manifestPath = path.join(process.cwd(), "public", ".image-manifest.json");
  if (fs.existsSync(manifestPath)) {
    const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf-8"));
    const m = manifest[entry.data.hero];
    if (m) {
      for (const fmt of ["avif", "webp"] as const) {
        const widths = m.variants?.[fmt];
        if (!widths || !widths.length) continue;
        const srcset = widths
          .map(
            (w: number) =>
              `${base}${entry.data.hero!.replace(/\.[^.]+$/, `-${w}.${fmt}`)} ${w}w`
          )
          .join(", ");
        heroPreloads.push({ type: `image/${fmt}`, srcset, sizes: "100vw" });
      }
    }
  }
}

const all = (await getCollection("research", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.slug === entry.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const titleDisplay =
  lang === "zh" && entry.data.titleZh ? entry.data.titleZh : entry.data.title;

// "blurb" is the research-collection equivalent of project "note" — use it
// as the studio-note pull quote at the head of the page.
const note =
  lang === "zh" && entry.data.blurbZh
    ? entry.data.blurbZh
    : entry.data.blurb;
const noteLabel = t(lang, "research.note_label");

const orderTwo = String(entry.data.order ?? 1).padStart(2, "0");
---

<BaseLayout title={titleDisplay} description={entry.data.blurb} lang={lang}>
  {
    heroPreloads.map((p) => (
      <link
        slot="head"
        rel="preload"
        as="image"
        type={p.type}
        imagesrcset={p.srcset}
        imagesizes={p.sizes}
      />
    ))
  }

  <article class="case case--left">
    <header class="case__head container">
      <div class="case__head-rail">
        <span class="case__seq" aria-hidden="true">{orderTwo}</span>
        <span class="case__rule" aria-hidden="true"></span>
        <p class="eyebrow case__eyebrow">{t(lang, "research.case_eyebrow")}</p>
      </div>
      <h1 class="case__title">{titleDisplay}</h1>
      <p class="case__attribution">{t(lang, "research.attribution")}</p>
    </header>

    {entry.data.hero && (
      <figure class="case__hero">
        <Picture
          src={entry.data.hero}
          alt={`${entry.data.title} — cover`}
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
        />
      </figure>
    )}

    {note && (
      <section class="case__note container">
        <div class="case__note-inner">
          <p class="eyebrow case__note-label">{noteLabel}</p>
          <blockquote class="case__note-text">
            <p>{note}</p>
          </blockquote>
        </div>
      </section>
    )}

    <section
      class:list={[
        "case__body",
        lang === "en" && !hasEnBody && "case__body--visual",
      ]}
    >
      <div class="prose">
        <Content />
      </div>
    </section>

    {lang === "en" && !hasEnBody && (
      <p class="case__lang-note container">
        {t(lang, "research.body_note")}
      </p>
    )}

    <nav class="container case__nav" aria-label="Research navigation">
      <a href={`${langPrefix}/research`} class="case__back">
        {t(lang, "research.back")}
      </a>
      <div class="case__pager">
        {prev && (
          <a
            href={`${langPrefix}/research/${prev.slug}`}
            class="case__pager-item"
          >
            <span class="eyebrow">{t(lang, "research.prev")}</span>
            <span>
              {lang === "zh" && prev.data.titleZh
                ? prev.data.titleZh
                : prev.data.title}
            </span>
          </a>
        )}
        {next && (
          <a
            href={`${langPrefix}/research/${next.slug}`}
            class="case__pager-item case__pager-item--right"
          >
            <span class="eyebrow">{t(lang, "research.next")}</span>
            <span>
              {lang === "zh" && next.data.titleZh
                ? next.data.titleZh
                : next.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* ============================================================
     Research case study — mirrors ProjectCaseBody's structure so
     the two collections share the same plate template. The .case
     selectors below are a local copy of the project-case CSS;
     keeping them inside this component means the research page
     stays self-contained even though it uses the same class names.
     ============================================================ */

  .case {
    --case-pad-top: var(--space-5);
  }

  .case__head {
    padding-top: var(--case-pad-top);
    padding-bottom: var(--space-3);
  }
  .case__head-rail {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .case__seq {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--fg-subtle);
    font-feature-settings: "tnum" 1;
  }
  .case__rule {
    height: 1px;
    background: var(--border);
  }
  .case__eyebrow {
    margin: 0;
    text-align: right;
  }

  .case__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-h1-xl);
    line-height: 0.96;
    letter-spacing: -0.032em;
    margin: var(--space-3) 0 0.4rem;
    max-width: 18ch;
  }

  .case__attribution {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin: 0 0 var(--space-3);
  }

  .case__hero {
    margin: var(--space-3) 0 var(--space-4);
    padding: 0;
  }
  .case__hero :global(picture),
  .case__hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 1024px) {
    .case__hero :global(picture),
    .case__hero :global(img) {
      max-height: 84vh;
      object-fit: cover;
    }
  }

  /* ----- Studio note — magazine pull-quote ---------------------------- */
  .case__note {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .case__note-inner {
    position: relative;
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }
  @media (min-width: 880px) {
    .case__note-inner {
      grid-template-columns: repeat(12, 1fr);
      column-gap: clamp(1rem, 2vw, 2rem);
      align-items: start;
    }
  }
  .case__note-label {
    margin: 0;
    align-self: start;
  }
  @media (min-width: 880px) {
    .case__note-label {
      grid-column: 1 / span 3;
      padding-top: 0.5rem;
    }
  }
  .case__note-text {
    margin: 0;
    padding: 0;
    border: 0;
    position: relative;
  }
  @media (min-width: 880px) {
    .case__note-text {
      grid-column: 4 / span 8;
      max-width: 60ch;
    }
  }
  .case__note-text p {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-pullquote);
    line-height: 1.38;
    letter-spacing: -0.012em;
    color: var(--fg);
    margin: 0;
    max-width: none;
    text-indent: 0;
  }
  .case__note-text p::before {
    content: "“";
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 300;
    color: var(--fg-subtle);
    margin-right: 0.05em;
    margin-left: -0.35em;
  }
  .case__note-text p::after {
    content: "”";
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 300;
    color: var(--fg-subtle);
    margin-left: 0.05em;
  }
  :global(html[lang^="zh"]) .case__note-text p {
    line-height: 1.55;
    letter-spacing: 0.005em;
    font-style: normal;
  }
  :global(html[lang^="zh"]) .case__note-text p::before,
  :global(html[lang^="zh"]) .case__note-text p::after {
    content: none;
  }

  /* ----- Body — vertical-stack plates ------------------------------- */
  .case__body {
    padding: var(--space-5) 0 var(--space-4);
  }
  .prose {
    /* the plate / plate__intro / plate__media-grid styles in
       global.css carry the layout — the prose container only needs
       to provide vertical rhythm */
    display: block;
  }
  .prose :global(.plate) {
    padding: var(--space-5) 0;
  }
  .prose :global(.plate:first-child) {
    padding-top: 0;
  }
  .prose :global(.plate--intro) {
    padding-bottom: var(--space-3);
  }
  .prose :global(.plate--intro .plate__intro p) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-lede-lg);
    line-height: var(--leading-snug);
    color: var(--fg);
  }
  :global(html[lang^="zh"]) .prose :global(.plate--intro .plate__intro p) {
    line-height: var(--leading-cn);
  }
  .prose :global(.plate--text-only) {
    padding: var(--space-4) 0;
  }

  /* ----- Lang note + nav --------------------------------------------- */
  .case__lang-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
    text-align: center;
    padding: var(--space-2) 0;
    text-transform: uppercase;
  }
  .case__nav {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .case__back {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .case__back:hover {
    color: var(--fg);
  }
  .case__pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 720px) {
    .case__pager {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }
  }
  .case__pager-item {
    display: grid;
    gap: 0.5rem;
    border-top: 1px solid var(--border);
    padding-top: var(--space-2);
    color: var(--fg);
    transition: border-color var(--transition);
  }
  .case__pager-item:hover {
    border-top-color: var(--fg);
  }
  .case__pager-item span:nth-child(2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-lede-lg);
    letter-spacing: -0.012em;
    line-height: 1.2;
  }
  .case__pager-item--right {
    text-align: right;
  }
</style>
