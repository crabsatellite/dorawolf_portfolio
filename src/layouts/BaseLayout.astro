---
import "~/styles/global.css";
import Nav from "~/components/Nav.astro";
import Footer from "~/components/Footer.astro";
import { langFromPath, t, type Lang } from "~/i18n/strings";
import { loadSite } from "~/i18n/loadData";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const detected = langFromPath(Astro.url.pathname.replace(base, "") || "/");
const { title, description, ogImage, lang = detected } = Astro.props;
const site = loadSite(lang);

const fallbackDescription =
  lang === "en"
    ? `${site.fullName} (${site.name}) — architect and designer based in ${site.location}.`
    : `${site.fullName}（${site.name}）—— 建筑师与设计师,坐标 ${site.location}。`;

const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const htmlLang = lang === "en" ? "en" : "zh-Hans-CN";
---

<!doctype html>
<html lang={htmlLang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <slot name="head" />

    <title>{fullTitle}</title>
    <meta name="description" content={description || fallbackDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description || fallbackDescription} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <script is:inline>
      // Mark JS as available so the reveal/cursor/fade-in styles take effect.
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("html-js");

      // -------------------------------------------------------------------
      // Connection-aware image policy.
      //
      // Runs in <head> BEFORE the body so CSS that keys off slow-net /
      // save-data classes paints the right placeholder from the first
      // frame (no FOUC). Reads the Network Information API where
      // available and falls back to "fast" when unsupported.
      //
      // We also expose the policy globally so the body script that
      // patches <picture><source sizes=…> for progressive-size loading
      // can reuse the decision without re-reading navigator.connection.
      // -------------------------------------------------------------------
      (function () {
        var html = document.documentElement;
        var c =
          navigator.connection ||
          navigator.mozConnection ||
          navigator.webkitConnection ||
          null;

        var effective = c && c.effectiveType ? String(c.effectiveType) : "4g";
        var saveData = !!(c && c.saveData);
        var downlink = c && typeof c.downlink === "number" ? c.downlink : null;
        var slow =
          saveData ||
          effective === "slow-2g" ||
          effective === "2g" ||
          effective === "3g" ||
          (downlink !== null && downlink > 0 && downlink < 1.0);

        html.setAttribute("data-effective-type", effective);
        if (saveData) html.classList.add("save-data");
        html.classList.add(slow ? "slow-net" : "fast-net");

        // Stash for the body-end <source sizes> patcher.
        window.__netPolicy = {
          slow: slow,
          saveData: saveData,
          effectiveType: effective,
          downlink: downlink,
        };
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      {lang === "en" ? "Skip to content" : "跳到内容"}
    </a>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <dialog class="lightbox" id="lightbox" aria-label="Image viewer">
      <div class="lightbox__inner" id="lightbox-inner"></div>
      <div class="lightbox__bar">
        <button type="button" data-lb-prev aria-label={t(lang, "lightbox.prev")}>←</button>
        <span data-lb-counter></span>
        <button type="button" data-lb-next aria-label={t(lang, "lightbox.next")}>→</button>
        <button type="button" data-lb-close aria-label={t(lang, "lightbox.close")}>{t(lang, "lightbox.close")} ✕</button>
      </div>
    </dialog>

    <script is:inline>
      // ----- Connection-aware <source sizes> patch -------------------------
      // For slow networks / Save-Data, narrow the `sizes` hint on every
      // <picture><source> so the browser picks a smaller variant from
      // the existing srcset. This runs synchronously at the end of body
      // parse, before any lazy <img> enters the viewport, so the
      // preload-scanner that would otherwise have requested a 2000w
      // variant on a phone instead picks the 400w / 800w one.
      //
      // Eager hero images may have already begun fetching by the time
      // this runs — that is acceptable (the hero is full-bleed and
      // wants the larger variant anyway).
      (function () {
        var policy = window.__netPolicy || { slow: false, saveData: false };
        if (!policy.slow && !policy.saveData) return;
        var slowSizes = policy.saveData ? "400px" : "480px";
        var sources = document.querySelectorAll("picture.lqip > source");
        for (var i = 0; i < sources.length; i++) {
          sources[i].setAttribute("sizes", slowSizes);
        }
        // Also tighten the sizes attr on the fallback <img> (some
        // browsers use it when no <source> matches).
        var imgs = document.querySelectorAll("picture.lqip > img[srcset]");
        for (var j = 0; j < imgs.length; j++) {
          imgs[j].setAttribute("sizes", slowSizes);
        }
      })();

      // ----- Image fade-in -------------------------------------------------
      (function () {
        var imgs = document.querySelectorAll("picture.lqip > img");
        for (var i = 0; i < imgs.length; i++) {
          var img = imgs[i];
          if (img.complete && img.naturalHeight !== 0) {
            img.classList.add("is-loaded");
          } else {
            img.addEventListener(
              "load",
              (function (el) {
                return function () {
                  el.classList.add("is-loaded");
                };
              })(img),
              { once: true }
            );
          }
        }
      })();

      // ----- Lightbox ------------------------------------------------------
      (function () {
        var dlg = document.getElementById("lightbox");
        if (!dlg || typeof dlg.showModal !== "function") return;
        var inner = document.getElementById("lightbox-inner");
        var counter = dlg.querySelector("[data-lb-counter]");
        var prevBtn = dlg.querySelector("[data-lb-prev]");
        var nextBtn = dlg.querySelector("[data-lb-next]");
        var closeBtn = dlg.querySelector("[data-lb-close]");
        var list = [];
        var idx = 0;

        function render() {
          var pic = list[idx];
          if (!pic) return;
          var img = pic.querySelector("img");
          if (!img) return;
          inner.innerHTML = "";
          var big = document.createElement("img");
          big.src = img.currentSrc || img.src;
          big.alt = img.alt || "";
          inner.appendChild(big);
          if (counter)
            counter.textContent =
              list.length > 1 ? idx + 1 + " / " + list.length : "";
        }

        function open(pic) {
          var group = pic.closest(".plate__media") || pic.closest(".prose") || document;
          list = Array.prototype.slice.call(
            group.querySelectorAll("picture.lqip")
          );
          if (list.indexOf(pic) === -1) {
            list = [pic];
          }
          idx = list.indexOf(pic);
          render();
          if (typeof dlg.showModal === "function") dlg.showModal();
        }

        document.addEventListener("click", function (e) {
          var t = e.target;
          while (t && t !== document) {
            if (t.tagName === "PICTURE" && t.classList.contains("lqip")) {
              e.preventDefault();
              open(t);
              return;
            }
            if (t === dlg) break;
            t = t.parentNode;
          }
        });

        function close() {
          if (dlg.open) dlg.close();
          inner.innerHTML = "";
        }
        function next() {
          if (!list.length) return;
          idx = (idx + 1) % list.length;
          render();
        }
        function prev() {
          if (!list.length) return;
          idx = (idx - 1 + list.length) % list.length;
          render();
        }

        prevBtn && prevBtn.addEventListener("click", function (e) { e.stopPropagation(); prev(); });
        nextBtn && nextBtn.addEventListener("click", function (e) { e.stopPropagation(); next(); });
        closeBtn && closeBtn.addEventListener("click", close);

        dlg.addEventListener("click", function (e) {
          if (e.target === dlg || e.target === inner || e.target.tagName === "IMG") {
            close();
          }
        });

        document.addEventListener("keydown", function (e) {
          if (!dlg.open) return;
          if (e.key === "ArrowRight") next();
          else if (e.key === "ArrowLeft") prev();
          else if (e.key === "Escape") close();
        });
      })();

      // ----- Scroll progress ----------------------------------------------
      (function () {
        var bar = document.getElementById("scroll-progress");
        if (!bar) return;
        var ticking = false;
        function update() {
          var doc = document.documentElement;
          var max = (doc.scrollHeight - doc.clientHeight) || 1;
          var p = Math.min(1, Math.max(0, doc.scrollTop / max));
          bar.style.transform = "scaleX(" + p + ")";
          ticking = false;
        }
        window.addEventListener(
          "scroll",
          function () {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
        update();
      })();

      // ----- Scroll-reveal -------------------------------------------------
      (function () {
        if (!("IntersectionObserver" in window)) return;
        var prefersReduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (prefersReduced) return;

        // Selector list — anything we want to fade-up on scroll.
        var sel = [
          ".section--hero h1",
          ".section--hero .lede",
          ".section--hero .hero__lede p",
          ".section--hero .eyebrow",
          ".project-item",
          ".plate",
          ".threads article",
          ".t-item",
          ".exp__item",
          ".proj__item",
          ".awards li",
          ".chip-list li",
          ".about-h2",
          ".featured__caption",
          "h2",
        ].join(",");
        var nodes = document.querySelectorAll(sel);
        for (var i = 0; i < nodes.length; i++) {
          nodes[i].classList.add("reveal");
        }
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add("in-view");
                io.unobserve(entries[i].target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        for (var j = 0; j < nodes.length; j++) {
          io.observe(nodes[j]);
        }
      })();

      // ----- Project-list hover preview -----------------------------------
      (function () {
        var canHover =
          window.matchMedia && window.matchMedia("(hover: hover)").matches;
        var prefersReduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!canHover || prefersReduced) return;

        var prev = document.createElement("div");
        prev.className = "hover-preview";
        document.body.appendChild(prev);

        var on = false,
          rafId = 0,
          targetX = 0,
          targetY = 0,
          curX = -9999,
          curY = -9999;

        function tick() {
          curX += (targetX - curX) * 0.18;
          curY += (targetY - curY) * 0.18;
          prev.style.transform =
            "translate3d(" + (curX + 30) + "px," + (curY - 80) + "px,0)";
          rafId = window.requestAnimationFrame(tick);
        }

        document.addEventListener(
          "mousemove",
          function (e) {
            targetX = e.clientX;
            targetY = e.clientY;
            if (!rafId) rafId = window.requestAnimationFrame(tick);
          },
          { passive: true }
        );

        document.addEventListener("mouseover", function (e) {
          var t = e.target.closest && e.target.closest("[data-preview]");
          if (!t) return;
          var src = t.getAttribute("data-preview");
          if (!src) return;
          prev.style.backgroundImage = 'url("' + src + '")';
          // Snap to current cursor on first show to avoid a fly-in from far.
          curX = targetX;
          curY = targetY;
          prev.classList.add("is-on");
          on = true;
        });

        document.addEventListener("mouseout", function (e) {
          var t = e.target.closest && e.target.closest("[data-preview]");
          if (!t) return;
          var to = e.relatedTarget && e.relatedTarget.closest
            ? e.relatedTarget.closest("[data-preview]")
            : null;
          if (to === t) return;
          prev.classList.remove("is-on");
          on = false;
        });
      })();

      // ----- Custom cursor (desktop only) ---------------------------------
      (function () {
        // Skip on touch devices and reduced-motion
        var canHover =
          window.matchMedia && window.matchMedia("(hover: hover)").matches;
        var prefersReduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!canHover || prefersReduced) return;

        var dot = document.createElement("div");
        var ring = document.createElement("div");
        dot.className = "cursor-dot";
        ring.className = "cursor-ring";
        document.body.appendChild(dot);
        document.body.appendChild(ring);

        var dx = -50,
          dy = -50,
          rx = -50,
          ry = -50,
          raf = 0;
        function tick() {
          rx += (dx - rx) * 0.18;
          ry += (dy - ry) * 0.18;
          dot.style.transform = "translate3d(" + (dx - 3) + "px," + (dy - 3) + "px,0)";
          ring.style.transform = "translate3d(" + (rx - 17) + "px," + (ry - 17) + "px,0)";
          raf = window.requestAnimationFrame(tick);
        }
        window.addEventListener(
          "mousemove",
          function (e) {
            dx = e.clientX;
            dy = e.clientY;
            if (!raf) raf = window.requestAnimationFrame(tick);
          },
          { passive: true }
        );

        // Expand the ring when the cursor is over an interactive surface.
        var hoverSel = "a, button, picture.lqip, .plate__link, [data-lang-switch]";
        document.addEventListener("mouseover", function (e) {
          if (e.target.closest && e.target.closest(hoverSel)) {
            ring.classList.add("is-hover");
          }
        });
        document.addEventListener("mouseout", function (e) {
          if (e.target.closest && e.target.closest(hoverSel)) {
            ring.classList.remove("is-hover");
          }
        });
        window.addEventListener("mousedown", function () {
          ring.classList.add("is-press");
        });
        window.addEventListener("mouseup", function () {
          ring.classList.remove("is-press");
        });
        window.addEventListener("mouseleave", function () {
          dot.style.opacity = "0";
          ring.style.opacity = "0";
        });
        window.addEventListener("mouseenter", function () {
          dot.style.opacity = "";
          ring.style.opacity = "";
        });
      })();
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--fg);
        color: var(--bg);
        padding: 0.5rem 1rem;
        z-index: 100;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
      }
    </style>
  </body>
</html>
