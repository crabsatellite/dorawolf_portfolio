---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("research", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Research"
  description="Computational design tooling at the heart of the studio's daily workflow — Sketchup and Grasshopper studies."
>
  <section class="section section--hero container">
    <p class="eyebrow">Research</p>
    <h1>Tools as <em>instruments</em>, not as the design.</h1>
    <p class="lede">
      Computational tools earn their place when they let the studio test more
      alternatives, more honestly, in less time. Two long studies — Sketchup
      and Grasshopper — collected here as ongoing logs.
    </p>
  </section>

  <section class="section container">
    <ol class="research-grid">
      {
        items.map((item) => {
          const heroSrc = item.data.hero ? `${base}${item.data.hero}` : null;
          return (
            <li>
              <a href={`${base}/research/${item.slug}`} class="card">
                <div class="card__cover" aria-hidden="true">
                  {heroSrc ? (
                    <img src={heroSrc} alt="" loading="lazy" />
                  ) : (
                    <span class="card__placeholder" />
                  )}
                </div>
                <div class="card__body">
                  <h3>{item.data.title}</h3>
                  {item.data.titleZh && (
                    <p class="card__zh">{item.data.titleZh}</p>
                  )}
                  <p class="card__blurb">{item.data.blurb}</p>
                  <span class="card__cta">
                    Read study <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ol>

    <div class="research-note">
      <p>
        <strong>What's not here.</strong> Tools that look impressive but are
        rarely used in real schemes don't earn a page. The studio prefers a
        small kit, used well.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  h1 em {
    font-style: italic;
    color: var(--accent);
    font-weight: 300;
  }
  .lede {
    font-family: var(--font-display);
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: var(--leading-snug);
    max-width: 60ch;
    margin-top: var(--space-3);
  }
  .research-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 880px) {
    .research-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }
  .card {
    display: block;
    color: inherit;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    overflow: hidden;
    transition:
      transform var(--transition),
      border-color var(--transition);
  }
  .card:hover {
    border-color: var(--fg);
    transform: translateY(-2px);
  }
  .card__cover {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #efeee8 0%, #d8d6cf 100%);
    overflow: hidden;
  }
  .card__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .card:hover .card__cover img {
    transform: scale(1.04);
  }
  .card__body {
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .card__body h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0 0 0.25rem;
  }
  .card__zh {
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin: 0 0 0.7rem;
  }
  .card__blurb {
    color: var(--fg);
    font-size: 0.96rem;
    margin-bottom: 1.2rem;
  }
  .card__cta {
    color: var(--accent);
    font-size: 0.92rem;
  }
  .research-note {
    margin-top: var(--space-5);
    padding: var(--space-3);
    border-left: 2px solid var(--accent);
    background: var(--bg-elevated);
    color: var(--fg-muted);
    max-width: 60ch;
  }
  .research-note p {
    margin: 0;
  }
  .research-note strong {
    color: var(--fg);
    font-weight: 500;
  }
</style>
