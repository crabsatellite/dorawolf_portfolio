---
import BaseLayout from "~/layouts/BaseLayout.astro";
import experience from "../../data/experience.json";

const cleanRecord = (rec: any) =>
  Object.fromEntries(Object.entries(rec).filter(([k]) => !k.startsWith("$")));
const entries = experience.map(cleanRecord);
---

<BaseLayout title="Timeline" description="Education and practice timeline.">
  <section class="section section--hero container">
    <p class="eyebrow">Timeline</p>
    <h1>Where the studio<br />came from.</h1>
  </section>

  <section class="section container">
    <ol class="timeline">
      {
        entries.map((e: any) => (
          <li class:list={["t-item", `t-item--${e.kind}`]}>
            <span class="t-item__range">{e.range}</span>
            <div class="t-item__body">
              <h3 class="t-item__title">{e.title}</h3>
              {e.titleZh && <p class="t-item__title-zh">{e.titleZh}</p>}
              <p class="t-item__org">
                {e.org}
                {e.location && <span class="t-item__loc"> · {e.location}</span>}
              </p>
              {e.orgZh && <p class="t-item__org-zh">{e.orgZh}</p>}
              {e.note && <p class="t-item__notes">{e.note}</p>}
            </div>
            <span class="t-item__kind">
              {e.kind === "work" ? "Practice" : "Education"}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .t-item {
    display: grid;
    grid-template-columns: 9rem 1fr 7rem;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .t-item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .t-item__range {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    font-feature-settings: "tnum" 1;
  }
  .t-item__title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 0 0 0.3rem;
    letter-spacing: -0.012em;
  }
  .t-item__title-zh {
    margin: -0.15rem 0 0.4rem;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .t-item__org {
    margin: 0;
    color: var(--fg);
  }
  .t-item__org-zh {
    margin: 0.2rem 0 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .t-item__loc {
    color: var(--fg-muted);
  }
  .t-item__notes {
    margin: 0.7rem 0 0;
    color: var(--fg-muted);
    max-width: 60ch;
    line-height: var(--leading-cn);
  }
  .t-item__kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    text-align: right;
  }
  @media (max-width: 720px) {
    .t-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .t-item__kind {
      text-align: left;
      order: -1;
    }
  }
</style>
