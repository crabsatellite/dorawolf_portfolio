---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Projects"
  description="Selected projects by Qingyuan Fu — education, infrastructure, and concept work."
>
  <section class="section section--hero container">
    <p class="eyebrow">Projects · {projects.length} works</p>
    <h1>Selected works.</h1>
    <p class="lede">
      School, competition, and studio years arranged in chronological order.
      Each entry holds a short brief and the design intent that drove the
      scheme.
    </p>
  </section>

  <section class="section container">
    <ol class="project-grid">
      {
        projects.map((p) => {
          const heroSrc = p.data.hero ? `${base}${p.data.hero}` : null;
          return (
            <li>
              <a href={`${base}/projects/${p.slug}`} class="card">
                <div class="card__cover" aria-hidden="true">
                  {heroSrc ? (
                    <img src={heroSrc} alt="" loading="lazy" />
                  ) : (
                    <span class="card__placeholder" />
                  )}
                  <span class="card__year">{p.data.year}</span>
                </div>
                <div class="card__body">
                  <h3>{p.data.title}</h3>
                  {p.data.titleZh && (
                    <p class="card__zh">{p.data.titleZh}</p>
                  )}
                  <p class="card__meta">
                    {[p.data.typology, p.data.location]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                  <p class="card__summary">{p.data.summary}</p>
                  <span class="card__cta">
                    Read project <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-2);
  }
  .lede {
    font-family: var(--font-display);
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: var(--leading-snug);
  }
  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 880px) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }
  .card {
    display: block;
    color: inherit;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    overflow: hidden;
    transition:
      transform var(--transition),
      border-color var(--transition);
  }
  .card:hover {
    border-color: var(--fg);
    transform: translateY(-2px);
  }
  .card__cover {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #efeee8 0%, #d8d6cf 100%);
    display: flex;
    align-items: flex-end;
    padding: 1rem 1.25rem;
    overflow: hidden;
  }
  .card__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .card:hover .card__cover img {
    transform: scale(1.04);
  }
  .card__year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--bg);
    background: rgba(20, 20, 20, 0.55);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    backdrop-filter: blur(4px);
    z-index: 1;
    position: relative;
  }
  .card__body {
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .card__body h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 0 0 0.25rem;
  }
  .card__zh {
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin: 0 0 0.6rem;
  }
  .card__meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }
  .card__summary {
    color: var(--fg);
    font-size: 0.96rem;
    margin-bottom: 1.2rem;
  }
  .card__cta {
    color: var(--accent);
    font-size: 0.92rem;
  }
</style>
