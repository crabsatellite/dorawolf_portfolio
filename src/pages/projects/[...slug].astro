---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await entry.render();

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const heroSrc = entry.data.hero
  ? `${base}${entry.data.hero}`
  : null;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="project">
    <header class="project__head container">
      <p class="eyebrow">
        Project · {entry.data.year}
        {entry.data.status && ` · ${entry.data.status}`}
      </p>
      <h1>{entry.data.title}</h1>
      {entry.data.titleZh && <p class="project__zh">{entry.data.titleZh}</p>}
      <p class="project__lede">{entry.data.summary}</p>
      <dl class="project__meta">
        {entry.data.dateZh && (
          <>
            <dt>Date</dt>
            <dd>{entry.data.dateZh}</dd>
          </>
        )}
        {entry.data.location && (
          <>
            <dt>Location</dt>
            <dd>{entry.data.location}</dd>
          </>
        )}
        {entry.data.role && (
          <>
            <dt>Role</dt>
            <dd>{entry.data.role}</dd>
          </>
        )}
        {entry.data.typology && (
          <>
            <dt>Typology</dt>
            <dd>{entry.data.typology}</dd>
          </>
        )}
      </dl>
    </header>

    {heroSrc && (
      <figure class="project__hero">
        <img
          src={heroSrc}
          alt={`${entry.data.title} — hero image`}
          loading="eager"
        />
      </figure>
    )}

    <section class="container project__body">
      <div class="prose">
        <Content />
      </div>
    </section>

    <nav class="container project__nav">
      <a href={`${base}/projects`} class="project__back">← All projects</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .project__head {
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
  }
  .project__head h1 {
    margin-top: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .project__zh {
    color: var(--fg-muted);
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0 0 1.2rem;
  }
  .project__lede {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: var(--leading-snug);
    max-width: 56ch;
    margin-top: var(--space-3);
    color: var(--fg-muted);
  }
  .project__meta {
    display: grid;
    grid-template-columns: 8rem 1fr;
    column-gap: 1rem;
    row-gap: 0.4rem;
    margin-top: var(--space-4);
    font-size: 0.92rem;
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
    max-width: 36rem;
  }
  .project__meta dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .project__meta dd {
    margin: 0;
  }
  .project__hero {
    margin: var(--space-3) 0 var(--space-5);
    padding: 0;
  }
  .project__hero img {
    width: 100%;
    height: auto;
    display: block;
  }
  .project__body {
    padding-top: var(--space-3);
    padding-bottom: var(--space-4);
  }
  .prose {
    max-width: 760px;
    margin: 0 auto;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    margin: var(--space-5) 0 var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.15rem;
    margin: var(--space-3) 0 var(--space-1);
  }
  .prose :global(p) {
    margin: 0 0 1rem;
    line-height: 1.85;
    letter-spacing: 0.01em;
    color: var(--fg);
  }
  .prose :global(p:has(img)) {
    margin: var(--space-3) 0;
    max-width: none;
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  .prose :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .project__nav {
    padding-bottom: var(--space-5);
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
    margin-top: var(--space-4);
  }
  .project__back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .project__back:hover {
    color: var(--fg);
  }
  @media (min-width: 920px) {
    .project__hero img {
      max-height: 78vh;
      object-fit: cover;
    }
  }
</style>
