---
import BaseLayout from "~/layouts/BaseLayout.astro";
import site from "../../data/site.json";
import about from "../../data/about.json";
import skills from "../../data/skills.json";
import experience from "../../data/experience.json";
import projectsRecord from "../../data/projects-record.json";
import awards from "../../data/awards.json";

// Flatten skills groups for the right-rail chip cloud
const allSkills = [
  ...skills.modeling,
  ...skills.rendering,
  ...skills.drafting,
  ...skills.graphics,
  ...skills.ai,
];

// Filter out the $comment field on records
const cleanRecord = (rec: any) =>
  Object.fromEntries(Object.entries(rec).filter(([k]) => !k.startsWith("$")));
const records = projectsRecord.map(cleanRecord);
const exp = experience.map(cleanRecord);
const aw = awards.map(cleanRecord);
---

<BaseLayout
  title="About"
  description={`${site.fullName} (${site.name}) is an architect and designer based in ${site.location}.`}
>
  <section class="section section--hero container">
    <p class="eyebrow">About</p>
    <h1>
      {site.fullName} &mdash; <em>architect</em>, designer.
    </h1>
    <p class="hero__zh">{site.fullNameZh} · {about.education.degreeZh}</p>
  </section>

  <section class="section container about">
    <div class="about__col about__col--lead">
      <h2 class="about__heading">关于我</h2>
      <p>{about.bioZh}</p>

      <h2 class="about__heading">About me</h2>
      <p>{about.bioEn}</p>

      <h2 class="about__heading">Education</h2>
      <p>
        <strong>{about.education.school}</strong> · {about.education.department}
        · {about.education.range}.
        Coursework: {about.education.courses.join(", ")}.
      </p>

      <h2 class="about__heading">Practice</h2>
      <ul class="exp">
        {
          exp
            .filter((e) => e.kind === "work")
            .map((e) => (
              <li>
                <span class="exp__range">{e.range}</span>
                <div>
                  <p class="exp__org">{e.org}</p>
                  <p class="exp__org-zh">{e.orgZh}</p>
                  <p class="exp__note">{e.note}</p>
                </div>
              </li>
            ))
        }
      </ul>

      <h2 class="about__heading">Selected projects on record</h2>
      <ul class="proj">
        {
          records.map((r: any) => (
            <li>
              <span class="proj__year">{r.year}</span>
              <span class="proj__title">
                <span class="proj__en">{r.en}</span>
                <span class="proj__zh">{r.zh}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="about__heading">Awards</h2>
      <ul class="awards">
        {
          aw.map((a: any) => (
            <li>
              <span>{a.title}</span>
              <span class="awards__prize">{a.prize}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="about__col about__col--side">
      <div>
        <p class="eyebrow">Based in</p>
        <p>{site.location}</p>
      </div>
      <div>
        <p class="eyebrow">Languages</p>
        <p>{about.languages.join(" · ")}</p>
      </div>
      <div>
        <p class="eyebrow">Works in</p>
        <p>{about.interests.join(" · ")}</p>
      </div>
      <div>
        <p class="eyebrow">Tools</p>
        <ul class="skills">
          {allSkills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Contact</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  h1 em {
    font-style: italic;
    color: var(--accent);
    font-weight: 300;
  }
  .hero__zh {
    color: var(--fg-muted);
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-top: -0.5rem;
  }
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  .about__col p,
  .about__col li {
    max-width: 64ch;
  }
  .about__heading {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    margin: var(--space-5) 0 var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .about__heading:first-child {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }
  .about__col--side {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    position: sticky;
    top: calc(64px + var(--space-3));
    align-self: start;
  }
  .about__col--side .eyebrow {
    margin-bottom: 0.2rem;
  }
  .about__col--side > div > p {
    margin: 0;
  }
  .skills {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skills li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
  }
  .exp {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exp li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--border);
  }
  .exp__range {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .exp__org {
    margin: 0;
    font-weight: 500;
  }
  .exp__org-zh {
    margin: 0.2rem 0 0.4rem;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .exp__note {
    margin: 0.4rem 0 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .proj {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .proj li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .proj li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .proj__year {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--fg-muted);
  }
  .proj__en {
    display: block;
    font-size: 0.98rem;
  }
  .proj__zh {
    display: block;
    color: var(--fg-muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .awards li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--border);
  }
  .awards li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .awards__prize {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  @media (min-width: 980px) {
    .about {
      grid-template-columns: 1.7fr 1fr;
      gap: var(--space-6);
    }
  }
</style>
