---
import BaseLayout from "~/layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Not found">
  <section class="section section--hero container nf">
    <p class="eyebrow">404</p>
    <h1>This page isn't here.</h1>
    <p>
      The page you're looking for has moved or doesn't exist on the redesigned
      site yet.
    </p>
    <a class="link" href={`${base}/`}>Back to home →</a>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 60vh;
  }
  .link {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    margin-top: var(--space-3);
    display: inline-block;
  }
</style>
