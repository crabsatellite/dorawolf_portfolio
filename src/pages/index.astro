---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="DoraWolf">
  <section class="section section--hero container">
    <p class="eyebrow">Selected works · 2021 — 2023</p>
    <h1>
      Architecture<br />
      that listens to its <em>site</em>,<br />
      its <em>climate</em>,<br />
      and the people who<br />
      will inhabit it.
    </h1>
    <p class="lede">
      Qingyuan Fu — known online as DoraWolf — is an architect and designer
      based in Wuhan. Trained at Hubei University of Technology and formed in
      practice at the China Architecture Design &amp; Research Group, the
      studio works across education, infrastructure, and public buildings,
      with a continuing interest in sustainable design and computational
      tools.
    </p>
    <div class="hero-actions">
      <a class="btn btn--primary" href={`${base}/projects`}>View projects</a>
      <a class="btn" href={`${base}/about`}>About</a>
    </div>
  </section>

  <section class="section container">
    <header class="section-head">
      <p class="eyebrow">Projects</p>
      <h2>Selected works</h2>
      <a class="section-head__link" href={`${base}/projects`}
        >All {projects.length} projects →</a
      >
    </header>
    <ol class="project-list">
      {
        projects.map((p) => (
          <li class="project-item">
            <a href={`${base}/projects/${p.slug}`}>
              <span class="project-item__year">{p.data.year}</span>
              <span class="project-item__title">
                <span class="project-item__title-en">{p.data.title}</span>
                {p.data.titleZh && (
                  <span class="project-item__title-zh">{p.data.titleZh}</span>
                )}
              </span>
              <span class="project-item__meta">
                {[p.data.typology, p.data.location].filter(Boolean).join(" · ")}
              </span>
              <span class="project-item__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container">
    <header class="section-head">
      <p class="eyebrow">Practice</p>
      <h2>Three threads</h2>
    </header>
    <div class="threads">
      <article>
        <h3>Site as origin</h3>
        <p>
          Each scheme begins by reading the existing topography, climate, and
          civic edges. Form follows from what the site already offers — the
          contour, the prevailing wind, the way people already cross the land.
        </p>
      </article>
      <article>
        <h3>Computational tools</h3>
        <p>
          Sketchup and Grasshopper sit at the centre of the studio's daily
          workflow, paired with Rhino for detail geometry and Ladybug for
          early-stage daylight and energy work. Tools are an instrument, not
          the design.
        </p>
      </article>
      <article>
        <h3>Public legibility</h3>
        <p>
          Public buildings are owed a calm, legible reading from the street.
          Where possible, schemes resolve to a single quiet datum visible from
          the city before any internal complexity reveals itself.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  h1 em {
    font-style: italic;
    color: var(--accent);
    font-weight: 300;
  }
  .lede {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
    margin-top: var(--space-3);
    max-width: 56ch;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.92rem;
    background: transparent;
    color: var(--fg);
    transition:
      background var(--transition),
      color var(--transition),
      border-color var(--transition);
  }
  .btn:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .btn--primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }
  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .section-head h2 {
    margin: 0;
    flex: 1;
  }
  .section-head__link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .section-head__link:hover {
    color: var(--fg);
  }

  .project-list {
    list-style: none;
    counter-reset: prj;
    margin: 0;
    padding: 0;
  }
  .project-item {
    counter-increment: prj;
    border-top: 1px solid var(--border);
  }
  .project-item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .project-item a {
    display: grid;
    grid-template-columns: 5rem 1fr auto 2rem;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.6rem 0;
    transition: padding-left var(--transition);
  }
  .project-item a:hover {
    padding-left: 0.5rem;
  }
  .project-item__year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .project-item__title-en {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: var(--leading-tight);
  }
  .project-item__title-zh {
    display: block;
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin-top: 0.2rem;
  }
  .project-item__meta {
    color: var(--fg-muted);
    font-size: 0.88rem;
    text-align: right;
  }
  .project-item__arrow {
    font-family: var(--font-mono);
    color: var(--fg-muted);
    transition: transform var(--transition);
  }
  .project-item a:hover .project-item__arrow {
    transform: translateX(0.4rem);
    color: var(--fg);
  }
  @media (max-width: 720px) {
    .project-item a {
      grid-template-columns: 4rem 1fr 1.5rem;
    }
    .project-item__meta {
      grid-column: 2 / 3;
      text-align: left;
      margin-top: 0.25rem;
    }
  }

  .threads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }
  .threads article {
    border-top: 1px solid var(--fg);
    padding-top: 1rem;
  }
  .threads h3 {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0;
  }
</style>
