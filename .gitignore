# build output
dist/
.astro/

# deps
node_modules/

# environment
.env
.env.production
.env.development

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# os
.DS_Store
Thumbs.db

# scrape staging (Phase 2)
_scrape/

# Design review screenshots (taken locally via _design/screenshot*.mjs)
_design/shots/
_design/shots-local/
_design/preview.log

# Generated image variants (created by scripts/build-images.mjs at prebuild)
public/**/*.avif
public/**/*.webp
# Manifest is committed so the rehype plugin works without running prebuild
!public/.image-manifest.json
